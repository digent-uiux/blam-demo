{%- comment -%} Password page: logo, message, newsletter sign-up, optional image and the store password form. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign split = false
  if s.layout == 'split'
    assign split = true
  endif
-%}
<div
  class="blko-section blko-scheme color-{{ s.color_scheme }} blko-password{% if split %} blko-password--split blko-password--media-{{ s.image_position }}{% endif %}"
  style="--blko-pt: {{ s.padding_top }}px; --blko-pb: {{ s.padding_bottom }}px;"
>
  <div class="blko-password__inner blko-password__inner--{{ s.alignment }}">
    {%- if s.show_logo -%}
      <div class="blko-password__brand">
        {%- if settings.logo != blank -%}
          {%- assign logo_w2 = settings.logo_width | times: 2 -%}
          {{ settings.logo | image_url: width: logo_w2 | image_tag: class: 'blko-password__logo', alt: shop.name }}
        {%- else -%}
          <span class="blko-display">{{ settings.logo_text | default: shop.name | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.heading != blank -%}<h1 class="blko-{{ s.heading_size }}">{{ s.heading }}</h1>{%- endif -%}
    {%- if s.use_shop_message and shop.password_message != blank -%}
      <p class="blko-body-lg blko-muted">{{ shop.password_message }}</p>
    {%- elsif s.text != blank -%}
      <div class="blko-rte blko-body-lg blko-muted">{{ s.text }}</div>
    {%- endif -%}

    {%- if s.show_newsletter -%}
      {%- form 'customer', class: 'blko-password__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prospect">
        <label for="BlkoPasswordNews-{{ section.id }}" class="blko-visually-hidden">{{ 'blko.newsletter.email' | t }}</label>
        {%- if form.posted_successfully? -%}
          <p class="blko-form-message" role="status">
            {%- if s.success_text != blank -%}{{ s.success_text | escape }}{%- else -%}{{ 'blko.newsletter.success' | t }}{%- endif -%}
          </p>
        {%- else -%}
          <div class="blko-field-row">
            <input id="BlkoPasswordNews-{{ section.id }}" class="blko-input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'blko.newsletter.email' | t }}">
            <button type="submit" class="blko-btn blko-btn--primary">
              {%- if s.button_label != blank -%}{{ s.button_label | escape }}{%- else -%}{{ 'blko.password.notify' | t }}{%- endif -%}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="blko-form-message blko-form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
        {%- if s.newsletter_note != blank -%}<p class="blko-small blko-muted">{{ s.newsletter_note | escape }}</p>{%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- if s.show_social -%}
      {%- render 'blko-social-icons' -%}
    {%- endif -%}

    {%- form 'storefront_password', class: 'blko-password__owner-form' -%}
      <details class="blko-details blko-password__owner"{% if form.errors %} open{% endif %}>
        <summary>{{ 'blko.password.owner' | t }}{%- render 'blko-icon', name: 'plus', size: 16 -%}</summary>
        <div class="blko-details__body blko-password__form">
          {%- if form.errors -%}
            <p class="blko-form-message blko-form-message--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <label for="BlkoStorePassword-{{ section.id }}" class="blko-small">{{ 'blko.password.label' | t }}</label>
          <div class="blko-field-row">
            <input id="BlkoStorePassword-{{ section.id }}" class="blko-input" type="password" name="password" autocomplete="current-password" required>
            <button type="submit" class="blko-btn blko-btn--outline">{{ 'blko.password.enter' | t }}</button>
          </div>
        </div>
      </details>
    {%- endform -%}
    {%- if s.show_copyright -%}
      <p class="blko-small blko-muted">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    {%- endif -%}
  </div>
  {%- if split -%}
    <div class="blko-media blko-password__media">
      {%- if s.image != blank -%}
        {%- assign img_alt = s.image.alt | escape -%}
        {{ s.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: img_alt, fetchpriority: 'high' }}
      {%- else -%}
        {%- render 'blko-fallback-image', name: 'password', sizes: '(min-width: 990px) 50vw, 100vw', eager: true -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .blko-password { display: grid; place-items: center; min-height: 100vh; padding-inline: var(--blko-gutter, 16px); }
  .blko-password__inner { display: grid; justify-items: center; gap: 1.5rem; width: 100%; max-width: 32rem; text-align: center; }
  .blko-password__inner--start { justify-items: start; text-align: left; }
  .blko-password__logo { width: var(--logo-width, 140px); height: auto; }
  .blko-password__form { display: grid; gap: .75rem; width: 100%; text-align: left; }
  .blko-password__owner-form, .blko-password__owner { width: 100%; text-align: left; }
  .blko-password__media { width: 100%; aspect-ratio: 4/3; }
  .blko-password__media img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 990px) {
    .blko-password--split { grid-template-columns: 1fr 1fr; gap: 4rem; padding-inline: var(--blko-gutter, 16px) 0; align-items: stretch; }
    .blko-password--split .blko-password__inner { align-self: center; justify-self: center; }
    .blko-password--split .blko-password__media { aspect-ratio: auto; height: 100%; min-height: 100vh; margin-block: calc(-1 * var(--blko-pt, 48px)) calc(-1 * var(--blko-pb, 48px)); }
    .blko-password--media-left .blko-password__media { order: -1; }
    .blko-password--media-left { padding-inline: 0 var(--blko-gutter, 16px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "class": "blko-main-password",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Content" },
    { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Opening soon" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "display", "label": "Extra large" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "use_shop_message",
      "label": "Use the message from Online Store preferences",
      "default": true
    },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Shown when the store message is off or empty.", "default": "<p>Small-batch skincare is on its way. Leave your email and we’ll write when the doors open.</p>" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter form", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "newsletter_note", "label": "Note under the form" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing. Your first letter arrives on Sunday." },
    { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": false },
    { "type": "checkbox", "id": "show_copyright", "label": "Show copyright", "default": true },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "split", "label": "Side by side with image" }
      ],
      "default": "center"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "start", "label": "Left" }
      ],
      "default": "center"
    }
  ]
}
{% endschema %}
