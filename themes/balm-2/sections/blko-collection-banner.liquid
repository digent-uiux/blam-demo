{%- comment -%}
  Collection banner: oat panel (title, description, pill link) beside a photo.
  With no image it collapses to a compact title + one line on the page background.
{%- endcomment -%}
{%- liquid
  if template.name == 'collection' and collection != blank
    assign banner_collection = collection
    assign is_page_title = true
  else
    assign banner_collection = section.settings.collection
    assign is_page_title = false
  endif

  assign heading = section.settings.heading | default: banner_collection.title
  assign link_url = section.settings.link_url | default: banner_collection.url
  assign image = blank
  if section.settings.show_image
    assign image = section.settings.image | default: banner_collection.image
  endif

  assign use_fallback = false
  if section.settings.show_image and image == blank
    assign use_fallback = true
  endif

  if image == blank and use_fallback == false
    assign pb = section.settings.compact_padding_bottom
  else
    assign pb = section.settings.padding_bottom
  endif

  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'landscape'
      assign ratio = '4 / 3'
    else
      assign ratio = '4 / 5'
  endcase
-%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-cbanner{% if image == blank and use_fallback == false %} blko-cbanner--text{% endif %}{% if section.settings.image_position == 'left' %} blko-cbanner--image-left{% endif %}{% if section.settings.text_alignment == 'center' %} blko-cbanner--center{% endif %}"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ pb }}px; --blko-cbanner-ratio: {{ ratio }};"
>
  <div class="blko-container">
    <div class="blko-cbanner__grid">
      <div class="blko-cbanner__panel">
        {%- if is_page_title -%}
          <h1 class="{{ section.settings.heading_size }} blko-cbanner__title">{{ heading | escape }}</h1>
        {%- else -%}
          <h2 class="{{ section.settings.heading_size }} blko-cbanner__title">{{ heading | default: section.settings.fallback_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.show_description -%}
          {%- if section.settings.description != blank -%}
            <div class="blko-body blko-muted blko-pretty blko-cbanner__text">{{ section.settings.description }}</div>
          {%- elsif banner_collection.description != blank -%}
            <div class="blko-body blko-muted blko-pretty blko-cbanner__text">{{ banner_collection.description }}</div>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.show_count and banner_collection != blank -%}
          <p class="blko-small blko-muted">{{ 'blko.collection.product_count' | t: count: banner_collection.products_count }}</p>
        {%- endif -%}
        {%- if section.settings.link_label != blank and link_url != blank -%}
          {%- if section.settings.button_style == 'pill' -%}
            <a class="blko-cbanner__link" href="{{ link_url }}">
              {{- section.settings.link_label | escape -}}
              <span class="blko-cbanner__link-icon">{%- render 'blko-icon', name: 'arrow-up-right' -%}</span>
            </a>
          {%- else -%}
            <a class="blko-btn blko-btn--{{ section.settings.button_style }} blko-cbanner__btn" href="{{ link_url }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if image != blank -%}
        <div class="blko-media blko-cbanner__media">
          {%- assign image_alt = image.alt | default: heading -%}
          {{
            image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              fetchpriority: 'high',
              alt: image_alt
          }}
        </div>
      {%- elsif use_fallback -%}
        <div class="blko-media blko-cbanner__media">
          {%- render 'blko-fallback-image', name: 'collection', sizes: '(min-width: 750px) 50vw, 100vw', eager: true -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .blko-cbanner__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: var(--radius-image, 0);
  }
  .blko-cbanner__panel {
    order: 2;
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: 3rem 1.5rem;
    background: var(--color-bg-alt, #e4e0cc);
  }
  .blko-cbanner__text { max-width: 36ch; }
  .blko-cbanner--center .blko-cbanner__panel { justify-items: center; text-align: center; }
  .blko-cbanner--center .blko-cbanner__link, .blko-cbanner--center .blko-cbanner__btn { justify-self: center; }
  .blko-cbanner__btn { justify-self: start; }
  .blko-cbanner__media { order: 1; aspect-ratio: var(--blko-cbanner-ratio, 4 / 5); border-radius: 0; }
  .blko-cbanner__link {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    gap: .75rem;
    height: 48px;
    padding: .25rem .25rem .25rem 1.5rem;
    border-radius: var(--radius-button, 999px);
    background: var(--color-button, #262f29);
    color: var(--color-button-text, #f6f2ea);
    font-size: var(--blko-text-button, 15px);
    font-weight: var(--button-weight, 500);
    text-transform: var(--button-case, none);
    letter-spacing: var(--button-tracking, 0);
    text-decoration: none;
    transition: background-color .2s;
  }
  .blko-cbanner__link:hover { background: var(--color-button-hover, #3d4a41); }
  .blko-cbanner__link-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-button, 999px);
    background: var(--color-button-text, #f6f2ea);
    color: var(--color-button, #262f29);
    transition: transform .2s;
  }
  .blko-cbanner__link-icon svg { width: 1rem; height: 1rem; }
  .blko-cbanner__link:hover .blko-cbanner__link-icon { transform: rotate(45deg); }
  /* No photo: just the title and one line on the page background, no empty half. */
  .blko-cbanner--text .blko-cbanner__grid { grid-template-columns: minmax(0, 1fr) !important; }
  .blko-cbanner--text .blko-cbanner__panel { padding: 0 !important; gap: .75rem; background: none; }
  .blko-cbanner--text .blko-cbanner__text { max-width: 60ch; }
  @media (min-width: 750px) {
    .blko-cbanner__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .blko-cbanner__panel { order: 1; padding: 4rem 3.5rem; }
    .blko-cbanner__media { order: 2; }
    .blko-cbanner--image-left .blko-cbanner__panel { order: 2; }
    .blko-cbanner--image-left .blko-cbanner__media { order: 1; }
    .blko-cbanner__title.blko-h3 { font-size: var(--blko-text-h2); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "blko-section-collection-banner",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1", "info": "The panel beside the image uses the scheme's alternate background." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "compact_padding_bottom", "label": "Bottom padding without image", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "Used when there is no image and the banner shows only the title and one line." },
    { "type": "header", "content": "Content" },
    {
      "type": "paragraph",
      "content": "On a collection page the banner uses that collection. Elsewhere it uses the collection picked below."
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title." },
    { "type": "text", "id": "fallback_heading", "label": "Heading when no collection is set", "default": "Serums that do one thing" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "blko-h3",
      "options": [
        { "value": "blko-h3", "label": "Medium" },
        { "value": "blko-h2", "label": "Large" },
        { "value": "blko-h1", "label": "Extra large" }
      ]
    },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "richtext", "id": "description", "label": "Description", "info": "Leave blank to use the collection description." },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Leave blank to hide the link." },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Leave blank to link to the collection." },
    {
      "type": "select", "id": "button_style", "label": "Link style", "default": "pill",
      "options": [
        { "value": "pill", "label": "Pill with arrow" },
        { "value": "primary", "label": "Solid button" },
        { "value": "outline", "label": "Outline button" }
      ]
    },
    { "type": "header", "content": "Image" },
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank to use the collection image, else a demo photo. Turn off Show image for a compact title." },
    {
      "type": "select", "id": "image_position", "label": "Image position on desktop", "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ]
    },
    {
      "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection banner",
      "settings": {
        "description": "<p>Single-active formulas for glow, calm or repair.</p>",
        "link_label": "Shop serums"
      }
    }
  ]
}
{% endschema %}
