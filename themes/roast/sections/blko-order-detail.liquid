{%- comment -%}
  Account order detail: order number, date and status, line items, summary (subtotal, shipping, total) and the
  delivery address. On customers/order it renders the real `order`; anywhere else (home page, Theme Editor) it
  renders the sample order from the settings and the "Line item" blocks.
{%- endcomment -%}
{{ 'blko-order-detail.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign is_real = false
  if order != blank
    assign is_real = true
  endif
  assign heading_tag = 'h2'
  if is_real
    assign heading_tag = 'h1'
  endif
  assign back_url = section.settings.back_link | default: routes.account_url
-%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-order-detail blko-order-detail--summary-{{ section.settings.summary_position }}"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="blko-container">
    {%- if section.settings.show_back and section.settings.back_label != blank -%}
      <a href="{{ back_url }}" class="blko-order-detail__back">{{ section.settings.back_label | escape }}</a>
    {%- endif -%}

    {%- if is_real == false and request.design_mode -%}
      <p class="blko-order-detail__sample blko-small blko-muted">{{ 'blko.order_detail.sample_note' | t }}</p>
    {%- endif -%}

    <div class="blko-order-detail__head">
      <div class="blko-order-detail__title">
        <p class="blko-label blko-muted">
          {{- section.settings.kicker_label | escape }}
          {% if is_real %}{{ order.order_number }}{% else %}{{ section.settings.sample_number | escape }}{% endif -%}
        </p>
        <{{ heading_tag }} class="blko-h1">{{ section.settings.heading | escape }}</{{ heading_tag }}>
        <p class="blko-muted">
          {{- section.settings.placed_label | escape }}
          {% if is_real %}{{ order.created_at | time_tag: format: 'date' }}{% else %}{{ section.settings.sample_date | escape }}{% endif -%}
        </p>
      </div>
      {%- liquid
        if is_real
          if order.cancelled
            assign status = 'blko.order_detail.cancelled' | t
          else
            assign status = order.fulfillment_status_label
          endif
        else
          assign status = section.settings.sample_status
        endif
      -%}
      {%- if status != blank -%}
        <span class="blko-order-detail__status">{{ status | escape }}</span>
      {%- endif -%}
    </div>

    <div class="blko-order-detail__grid">
      <div class="blko-order-detail__items">
        {%- if section.settings.items_heading != blank -%}
          <h2 class="blko-h4">{{ section.settings.items_heading | escape }}</h2>
        {%- endif -%}
        <ul class="blko-list-reset blko-order-detail__list" role="list">
          {%- if is_real -%}
            {%- for line in order.line_items -%}
              <li class="blko-order-detail__item">
                {%- if section.settings.show_images -%}
                  <div class="blko-media blko-order-detail__thumb">
                    {%- if line.image != blank -%}
                      {{ line.image | image_url: width: 240 | image_tag: loading: 'lazy', width: 80, height: 80, alt: line.title }}
                    {%- else -%}
                      {%- assign demo_index = forloop.index -%}{%- render 'blko-demo-card', index: demo_index, part: 'image', sizes: '80px' -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="blko-order-detail__info">
                  <h3 class="blko-body blko-medium">
                    {%- if line.url != blank -%}<a href="{{ line.url }}">{{ line.product.title | default: line.title | escape }}</a>{%- else -%}{{ line.product.title | default: line.title | escape }}{%- endif -%}
                  </h3>
                  <p class="blko-small blko-muted">
                    {%- if line.variant_title != blank -%}{{ line.variant_title | escape }} · {% endif -%}
                    {{- 'blko.order_detail.quantity' | t: quantity: line.quantity -}}
                  </p>
                  {%- if line.fulfillment.tracking_url != blank -%}
                    <a href="{{ line.fulfillment.tracking_url }}" class="blko-small blko-order-detail__track">{{ 'blko.customer.track' | t }}</a>
                  {%- endif -%}
                </div>
                <p class="blko-order-detail__price">
                  {%- if line.original_line_price > line.final_line_price -%}
                    <s class="blko-muted">{{ line.original_line_price | money }}</s>
                  {%- endif -%}
                  <strong>{{ line.final_line_price | money }}</strong>
                </p>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- assign sample_subtotal = 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign unit_cents = block.settings.price | times: 100 | round
                assign line_cents = unit_cents | times: block.settings.quantity
                assign sample_subtotal = sample_subtotal | plus: line_cents
                assign ph_i = forloop.index0 | modulo: 4
              -%}
              <li class="blko-order-detail__item" {{ block.shopify_attributes }}>
                {%- if section.settings.show_images -%}
                  <div class="blko-media blko-order-detail__thumb">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', width: 80, height: 80, alt: block.settings.title }}
                    {%- else -%}
                      {%- assign demo_index = ph_i | plus: 1 -%}{%- render 'blko-demo-card', index: demo_index, part: 'image', sizes: '80px' -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="blko-order-detail__info">
                  <h3 class="blko-body blko-medium">{{ block.settings.title | escape }}</h3>
                  <p class="blko-small blko-muted">
                    {%- if block.settings.variant != blank -%}{{ block.settings.variant | escape }} · {% endif -%}
                    {{- 'blko.order_detail.quantity' | t: quantity: block.settings.quantity -}}
                  </p>
                </div>
                <p class="blko-order-detail__price"><strong>{{ line_cents | money }}</strong></p>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>

      {%- liquid
        if is_real
          assign subtotal = order.line_items_subtotal_price
          assign shipping = order.shipping_price
          assign tax = order.tax_price
          assign total = order.total_price
        else
          assign shipping = section.settings.sample_shipping | times: 100 | round
          assign subtotal = sample_subtotal
          assign tax = 0
          assign total = sample_subtotal | plus: shipping
        endif
      -%}
      <aside class="blko-order-detail__summary" aria-label="{{ section.settings.summary_heading | escape }}">
        {%- if section.settings.summary_heading != blank -%}
          <h2 class="blko-h4">{{ section.settings.summary_heading | escape }}</h2>
        {%- endif -%}
        <dl class="blko-order-detail__totals">
          <div class="blko-order-detail__row">
            <dt>{{ section.settings.subtotal_label | escape }}</dt>
            <dd>{{ subtotal | money }}</dd>
          </div>
          {%- if is_real -%}
            {%- for discount in order.cart_level_discount_applications -%}
              <div class="blko-order-detail__row">
                <dt>{{ discount.title | default: section.settings.discount_label | escape }}</dt>
                <dd>-{{ discount.total_allocated_amount | money }}</dd>
              </div>
            {%- endfor -%}
          {%- endif -%}
          <div class="blko-order-detail__row">
            <dt>{{ section.settings.shipping_label | escape }}</dt>
            <dd>{% if shipping == 0 %}{{ section.settings.free_label | escape }}{% else %}{{ shipping | money }}{% endif %}</dd>
          </div>
          {%- if tax > 0 -%}
            <div class="blko-order-detail__row">
              <dt>{{ section.settings.tax_label | escape }}</dt>
              <dd>{{ tax | money }}</dd>
            </div>
          {%- endif -%}
          <div class="blko-order-detail__row blko-order-detail__row--total">
            <dt>{{ section.settings.total_label | escape }}</dt>
            <dd>{% if is_real %}{{ total | money_with_currency }}{% else %}{{ total | money }}{% endif %}</dd>
          </div>
        </dl>

        {%- if section.settings.show_address -%}
          {%- if is_real -%}
            {%- if order.shipping_address != blank -%}
              <div class="blko-order-detail__address">
                <h3 class="blko-medium">{{ section.settings.address_heading | escape }}</h3>
                <address class="blko-small">{{ order.shipping_address | format_address }}</address>
              </div>
            {%- endif -%}
          {%- elsif section.settings.sample_address != blank -%}
            <div class="blko-order-detail__address">
              <h3 class="blko-medium">{{ section.settings.address_heading | escape }}</h3>
              <address class="blko-small">{{ section.settings.sample_address | escape | newline_to_br }}</address>
            </div>
          {%- endif -%}
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Account order detail",
  "tag": "section",
  "class": "blko-order-detail-section",
  "max_blocks": 10,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "show_back", "label": "Show back link", "default": true },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "← Back to orders" },
    { "type": "url", "id": "back_link", "label": "Back link", "info": "Leave empty to link to the account page." },
    { "type": "text", "id": "kicker_label", "label": "Order number label", "default": "Order No." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order details" },
    { "type": "text", "id": "placed_label", "label": "Date label", "default": "Placed" },
    { "type": "header", "content": "Items" },
    { "type": "text", "id": "items_heading", "label": "Items heading", "default": "Items" },
    { "type": "checkbox", "id": "show_images", "label": "Show item images", "default": true },
    { "type": "header", "content": "Summary" },
    {
      "type": "select",
      "id": "summary_position",
      "label": "Summary position on large screens",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Order summary" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "discount_label", "label": "Discount label", "default": "Discount", "info": "Used when a discount has no title." },
    { "type": "text", "id": "shipping_label", "label": "Shipping label", "default": "Shipping" },
    { "type": "text", "id": "free_label", "label": "Free shipping label", "default": "Free" },
    { "type": "text", "id": "tax_label", "label": "Tax label", "default": "Tax" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "checkbox", "id": "show_address", "label": "Show delivery address", "default": true },
    { "type": "text", "id": "address_heading", "label": "Address heading", "default": "Delivery address" },
    { "type": "header", "content": "Sample order", "info": "Shown when there is no real order, for example on the home page. On a customer's order page the real order is shown." },
    { "type": "text", "id": "sample_number", "label": "Order number", "default": "1042" },
    { "type": "text", "id": "sample_date", "label": "Date", "default": "May 18, 2026" },
    { "type": "text", "id": "sample_status", "label": "Status", "default": "Delivered" },
    { "type": "number", "id": "sample_shipping", "label": "Shipping cost", "default": 0, "info": "0 shows the free shipping label. Subtotal and total add up from the line items." },
    { "type": "textarea", "id": "sample_address", "label": "Address", "default": "Sample Customer\n42 Example Street\nDemo City, 00000" }
  ],
  "blocks": [
    {
      "type": "line_item",
      "name": "Line item",
      "settings": [
        { "type": "paragraph", "content": "Sample line item. Only shown when there is no real order." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Rosehip face oil" },
        { "type": "text", "id": "variant", "label": "Variant", "default": "30 ml" },
        { "type": "range", "id": "quantity", "label": "Quantity", "min": 1, "max": 10, "step": 1, "default": 1 },
        { "type": "number", "id": "price", "label": "Unit price", "default": 48, "info": "In the store currency, for example 48 or 36.5." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Account order detail",
      "blocks": [
        { "type": "line_item", "settings": { "title": "Rosehip face oil", "variant": "30 ml", "quantity": 1, "price": 48 } },
        { "type": "line_item", "settings": { "title": "Niacinamide serum", "variant": "15 ml travel", "quantity": 1, "price": 36 } }
      ]
    }
  ]
}
{% endschema %}
