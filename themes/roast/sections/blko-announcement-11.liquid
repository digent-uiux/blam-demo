{%- liquid
  assign s = section.settings
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-announcement-11.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-roast-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-roast-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-announcement-11.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-roast', tokens: s.tokens -%}
{%- liquid
  assign show_bar = true
  if s.home_only and request.page_type != 'index'
    assign show_bar = false
  endif
-%}
{%- if show_bar and section.blocks.size > 0 -%}
<div class="bannouncement11" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-roast data-ms="{{ s.speed | times: 1000 }}"
  ><div role="region" aria-label="{{ 'blko.announcement_11.label' | t }}" class="bannouncement11__bar" data-bar
    ><div class="bannouncement11__row"
      ><p class="bannouncement11__label bannouncement11__live"><span aria-hidden="true" class="bannouncement11__dot"></span>{{ s.live_text | escape }}</p
      ><div class="bannouncement11__mid"
        ><button type="button" class="bannouncement11__arrow" data-go="-1" aria-label="{{ 'blko.announcement_11.prev' | t }}">{%- render 'blko-ui-icon', name: 'chevron-left', size: 14 -%}</button
        ><div aria-live="polite" class="bannouncement11__msgs"
          >{%- for b in section.blocks -%}
          <a href="{{ b.settings.link | default: '#' }}" class="bannouncement11__label bannouncement11__msg{% if forloop.first %} is-on{% else %} is-below{% endif %}" data-msg{% unless forloop.first %} tabindex="-1" aria-hidden="true"{% endunless %} {{ b.shopify_attributes }}><span class="rm-ul">{{ b.settings.text | escape }}</span></a
          >{%- endfor -%}
        </div
        ><button type="button" class="bannouncement11__arrow" data-go="1" aria-label="{{ 'blko.announcement_11.next' | t }}">{%- render 'blko-ui-icon', name: 'chevron-right', size: 14 -%}</button
      ></div
      >{%- if s.cal_text != blank -%}
      <a href="{{ s.cal_link | default: '#' }}" class="bannouncement11__label bannouncement11__cal"><span class="rm-ul">{{ s.cal_text | escape }}</span>{%- render 'blko-ui-icon', name: 'arrow-right', size: 14, className: 'rm-nudge' -%}</a
      >{%- endif -%}
    </div
    ><span aria-hidden="true" class="bannouncement11__timer" data-timer hidden><span data-fill></span></span
  ></div
></div
>{%- endif -%}

{% schema %}
{
  "name": "Announcement, rolling",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "home_only",
      "label": "Show on the home page only",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "live_text",
      "label": "Live label",
      "default": "Roasting today"
    },
    {
      "type": "text",
      "id": "cal_text",
      "label": "Calendar link label",
      "default": "Roast calendar"
    },
    {
      "type": "url",
      "id": "cal_link",
      "label": "Calendar link"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Seconds per message",
      "min": 3,
      "max": 9,
      "step": 0.5,
      "unit": "s",
      "default": 4.5
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Roast)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Next roast Monday · order by Sunday 6 pm"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement, rolling",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Next roast Monday · order by Sunday 6 pm"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Free shipping on orders over $45"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Roast club members save 15% on every bag"
          }
        }
      ]
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
