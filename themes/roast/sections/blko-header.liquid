{%- comment -%}
  Header: menu, wordmark (centre or left), search / account / bag icons, on a color scheme (Soft by default).
  The mobile drawer is a <details> panel built from the same menu.
{%- endcomment -%}
<script src="{{ 'blko-header.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign menu = section.settings.menu
  assign wordmark = settings.logo_text | default: shop.name
  # No menu yet (fresh store): show the demo categories, each linking to the collection of the same handle.
  assign fallback = section.settings.fallback_links | split: ','
  # Shopify's starter menus (Home / Catalog / Contact) count as "not set yet" while Demo menu is on.
  assign use_menu = false
  if menu.links.size > 0
    assign use_menu = true
    assign menu_titles = menu.links | map: 'title' | join: ','
    if section.settings.demo_menu
      if menu_titles == 'Home,Catalog,Contact' or menu_titles == 'Home,Catalog' or menu_titles == 'Search'
        assign use_menu = false
      endif
    endif
  endif
  assign show_account = false
  if section.settings.show_account and shop.customer_accounts_enabled
    assign show_account = true
  endif
-%}
<header
  class="blko-header blko-scheme color-{{ section.settings.color_scheme }} blko-header--logo-{{ section.settings.logo_position }}{% if section.settings.sticky %} blko-header--sticky{% endif %}{% if section.settings.show_border %} blko-header--border{% endif %}"
  style="--blko-header-pt: {{ section.settings.padding_top }}px; --blko-header-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="blko-header__inner">
    <blko-header-drawer class="blko-header__drawer">
      <details>
        <summary class="blko-btn blko-btn--ghost blko-btn--icon blko-header__icon" aria-label="{{ 'blko.header.open_menu' | t }}">
          {%- render 'blko-icon', name: 'menu' -%}
        </summary>
        <div class="blko-header__panel" id="BlkoMenuDrawer-{{ section.id }}" role="dialog" aria-modal="true" aria-label="{{ 'blko.header.menu' | t }}" tabindex="-1">
          <div class="blko-header__panel-top">
            <button type="button" class="blko-btn blko-btn--ghost blko-btn--icon" data-close aria-label="{{ 'blko.general.close' | t }}">
              {%- render 'blko-icon', name: 'close' -%}
            </button>
          </div>
          <nav aria-label="{{ 'blko.header.menu' | t }}">
            <ul class="blko-list-reset blko-header__drawer-list">
              {%- if use_menu -%}{%- for link in menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="blko-h4"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                  {%- if link.links.size > 0 -%}
                    <ul class="blko-list-reset blko-header__drawer-sub">
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}{%- endif -%}
              {%- unless use_menu -%}
                {%- for label in fallback -%}
                  {%- assign label = label | strip -%}
                  {%- if label == blank -%}{%- continue -%}{%- endif -%}
                  <li><a href="{{ routes.collections_url }}/{{ label | handleize }}" class="blko-h4">{{ label | escape }}</a></li>
                {%- endfor -%}
              {%- endunless -%}
            </ul>
          </nav>
          <div class="blko-header__drawer-foot">
            {%- if section.settings.show_search -%}
              <a href="{{ routes.search_url }}" class="blko-header__drawer-account">
                {%- render 'blko-icon', name: 'search' -%}
                {{- 'blko.header.search' | t -}}
              </a>
            {%- endif -%}
            {%- if show_account -%}
              <a href="{{ routes.account_url }}" class="blko-header__drawer-account">
                {%- render 'blko-icon', name: 'user' -%}
                {%- if customer -%}{{ 'blko.header.account' | t }}{%- else -%}{{ 'blko.header.log_in' | t }}{%- endif -%}
              </a>
            {%- endif -%}
          </div>
        </div>
        <div class="blko-header__overlay" data-close aria-hidden="true"></div>
      </details>
    </blko-header-drawer>

    <nav class="blko-header__nav" aria-label="{{ 'blko.header.main' | t }}">
      <ul class="blko-list-reset blko-header__nav-list">
        {%- if use_menu -%}
          {%- for link in menu.links -%}
            <li{% if forloop.index > 4 %} class="blko-header__nav-extra"{% endif %}>
              <a href="{{ link.url }}" class="blko-header__link"{% if link.current or link.child_active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for label in fallback -%}
            {%- assign label = label | strip -%}
            {%- if label == blank -%}{%- continue -%}{%- endif -%}
            <li{% if forloop.index > 4 %} class="blko-header__nav-extra"{% endif %}>
              <a href="{{ routes.collections_url }}/{{ label | handleize }}" class="blko-header__link">{{ label | escape }}</a>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    <div class="blko-header__brand-wrap">
      <a href="{{ routes.root_url }}" class="blko-header__brand">
        {%- if settings.logo != blank -%}
          {%- assign logo_w2 = settings.logo_width | times: 2 -%}
          {%- capture logo_sizes -%}{{ settings.logo_width }}px{%- endcapture -%}
          {{ settings.logo | image_url: width: logo_w2 | image_tag: class: 'blko-header__logo', widths: '200, 300, 400, 600', sizes: logo_sizes, alt: wordmark, loading: 'eager' }}
        {%- else -%}
          <span class="blko-header__wordmark">{{ wordmark | escape }}</span>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <span class="blko-header__tagline">{{ section.settings.tagline | escape }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="blko-header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="blko-btn blko-btn--ghost blko-btn--icon blko-header__icon blko-header__search" aria-label="{{ 'blko.header.search' | t }}">
          {%- render 'blko-icon', name: 'search' -%}
        </a>
      {%- endif -%}
      {%- if show_account -%}
        <a href="{{ routes.account_url }}" class="blko-btn blko-btn--ghost blko-btn--icon blko-header__icon blko-header__account" aria-label="{% if customer %}{{ 'blko.header.account' | t }}{% else %}{{ 'blko.header.log_in' | t }}{% endif %}">
          {%- render 'blko-icon', name: 'user' -%}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="blko-btn blko-btn--ghost blko-btn--icon blko-header__icon" id="BlkoCartIcon" aria-label="{{ 'blko.header.cart_count' | t: count: cart.item_count }}">
        {%- render 'blko-icon', name: 'bag' -%}
        {%- if cart.item_count > 0 or section.settings.show_empty_count -%}
          <span class="blko-header__count" aria-hidden="true">{% if cart.item_count < 100 %}{{ cart.item_count }}{% else %}99+{% endif %}</span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .blko-header-section:has(.blko-header--sticky) { position: sticky; top: 0; z-index: 40; }
  .blko-header--border { border-bottom: 1px solid color-mix(in srgb, var(--color-text, #262f29) 10%, transparent); }
  .blko-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .5rem; max-width: var(--blko-page, 1280px); min-height: 64px; margin-inline: auto; padding: calc(var(--blko-header-pt, 8px) * var(--blko-pad-k, 1)) calc(var(--blko-gutter, 16px) - .5rem) calc(var(--blko-header-pb, 8px) * var(--blko-pad-k, 1)); }
  .blko-header__drawer { justify-self: start; }
  .blko-header__nav { display: none; justify-self: start; }
  .blko-header__nav-list { display: flex; gap: 1.75rem; }
  .blko-header__nav-extra { display: none; }
  .blko-header__link { position: relative; display: inline-block; padding: .5rem 0; white-space: nowrap; text-decoration: none; font-size: 15px; }
  .blko-header__link::after { content: ""; position: absolute; inset-inline: 0; bottom: .25rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
  .blko-header__link:hover::after, .blko-header__link[aria-current="page"]::after { transform: scaleX(1); }
  .blko-header__brand-wrap { margin: 0; font: inherit; }
  .blko-header__brand { display: grid; justify-items: center; line-height: 1; text-decoration: none; white-space: nowrap; }
  .blko-header__logo { width: var(--logo-width, 140px); max-width: 50vw; height: auto; }
  .blko-header__wordmark { font-family: var(--font-heading, Georgia, serif); font-weight: var(--font-heading-weight, 500); font-size: var(--blko-text-h3, 22px); letter-spacing: -0.015em; }
  .blko-header__tagline { display: none; margin-top: .375rem; font-family: var(--blko-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace); font-size: var(--blko-text-label, 12px); opacity: .6; }
  .blko-header__icons { display: flex; align-items: center; justify-self: end; }
  .blko-header__icon { position: relative; }
  .blko-header__icon svg { width: 20px; height: 20px; }
  .blko-header__icon:hover { background: color-mix(in srgb, var(--color-bg-alt, #e4e0cc) 60%, transparent); }
  .blko-header__account { display: none; }
  .blko-header__count { position: absolute; top: 4px; right: 2px; display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 4px; border-radius: 999px; background: var(--color-text, #262f29); color: var(--color-bg, #f6f2ea); font-size: 11px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .blko-header__drawer summary { list-style: none; }
  .blko-header__drawer summary::-webkit-details-marker { display: none; }
  .blko-header__panel { position: fixed; inset: 0 auto 0 0; z-index: 61; display: flex; flex-direction: column; gap: 1.5rem; width: min(22rem, 88vw); padding: 1rem 1.5rem 2rem; overflow-y: auto; background: var(--color-bg, #f6f2ea); color: var(--color-text, #262f29); }
  .blko-header__overlay { position: fixed; inset: 0; z-index: 60; background: color-mix(in srgb, var(--color-text, #262f29) 40%, transparent); }
  .blko-header__panel-top { display: flex; justify-content: flex-end; margin-right: -.75rem; }
  .blko-header__drawer-list { display: grid; gap: 1rem; }
  .blko-header__drawer-list a { text-decoration: none; }
  .blko-header__drawer-list a[aria-current="page"] { text-decoration: underline; text-underline-offset: 4px; }
  .blko-header__drawer-sub { display: grid; gap: .5rem; margin-top: .625rem; padding-left: .25rem; font-size: var(--blko-text-small, 14px); color: var(--color-text-muted, #59625b); }
  .blko-header__drawer-foot { display: grid; gap: .75rem; margin-top: auto; }
  .blko-header__drawer-account { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; }
  .blko-header__drawer-account svg { width: 18px; height: 18px; }
  /* Logo left: drawer, wordmark, (nav), icons. */
  .blko-header--logo-left .blko-header__inner { grid-template-columns: auto minmax(0, 1fr) auto; }
  .blko-header--logo-left .blko-header__brand { justify-items: start; }
  .blko-header--logo-left .blko-header__brand-wrap { justify-self: start; }
  @media (min-width: 1024px) {
    .blko-header__inner { min-height: 96px; gap: 2rem; padding-inline: var(--blko-gutter, 32px); }
    .blko-header__drawer { display: none; }
    .blko-header__nav { display: block; }
    .blko-header__wordmark { font-size: var(--blko-text-h1, 48px); }
    .blko-header__tagline { display: block; }
    .blko-header__account { display: inline-flex; }
    .blko-header--logo-left .blko-header__inner { grid-template-columns: auto minmax(0, 1fr) auto; }
    .blko-header--logo-left .blko-header__brand-wrap { order: -1; }
    .blko-header--logo-left .blko-header__nav { justify-self: center; }
  }
  @media (min-width: 1280px) { .blko-header__nav-extra { display: list-item; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "blko-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Menu" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Also used for the mobile drawer." },
    { "type": "text", "id": "fallback_links", "label": "Demo menu", "default": "Skincare, Makeup, Hair, Body, Sale", "info": "Comma separated. Shown while no menu is set, or while the menu is Shopify's starter menu and Demo menu is on. Each links to the collection with the same handle." },
    { "type": "checkbox", "id": "demo_menu", "label": "Demo menu replaces the starter menu", "default": true, "info": "Turn off to show Shopify's starter menu (Home, Catalog, Contact) as it is." },
    { "type": "header", "content": "Logo" },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center",
      "info": "The logo and wordmark are set in Theme settings › Logo."
    },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Skincare for slow mornings", "info": "Shown under the wordmark on large screens." },
    { "type": "header", "content": "Icons" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true, "info": "Needs customer accounts turned on." },
    { "type": "checkbox", "id": "show_empty_count", "label": "Show cart count when empty", "default": true },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_border", "label": "Show bottom border", "default": true }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
