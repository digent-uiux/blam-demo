{%- comment -%}
  Cart page: line items, a summary column built from blocks (free-shipping bar, note, subtotal, text, buttons, apps),
  optional upsell products and an empty state. Quantity changes submit the form (blko-cart.js auto-submits).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div class="blko-section blko-scheme color-{{ s.color_scheme }} blko-cart blko-cart--{{ s.summary_style }}" style="--blko-pt: {{ s.padding_top }}px; --blko-pb: {{ s.padding_bottom }}px;">
  <div class="blko-container">
    {%- if s.heading != blank -%}
      <h1 class="blko-{{ s.heading_size }} blko-cart__title">{{ s.heading | escape }}</h1>
    {%- endif -%}
    {%- if cart.item_count > 0 -%}
      <script src="{{ 'blko-cart.js' | asset_url }}" defer="defer"></script>
      <blko-cart-form>
        <form action="{{ routes.cart_url }}" method="post" id="BlkoCartForm" class="blko-cart__layout" novalidate>
          <div class="blko-cart__items">
            <table class="blko-cart__table{% unless s.show_thumbnails %} blko-cart__table--no-thumbs{% endunless %}">
              <caption class="blko-visually-hidden">{{ 'blko.cart.items' | t }}</caption>
              <thead class="blko-visually-hidden">
                <tr>
                  <th scope="col">{{ 'blko.cart.product' | t }}</th>
                  <th scope="col">{{ 'blko.cart.quantity' | t }}</th>
                  <th scope="col">{{ 'blko.cart.total' | t }}</th>
                </tr>
              </thead>
              <tbody class="blko-divided blko-divided--edges">
                {%- for item in cart.items -%}
                  {%- assign item_title = item.product.title | escape -%}
                  <tr class="blko-cart__row">
                    <td class="blko-cart__product">
                      <a href="{{ item.url }}" class="blko-media blko-media--square blko-cart__thumb" tabindex="-1" aria-hidden="true">
                        {%- if item.image -%}
                          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '96px', alt: '' }}
                        {%- else -%}
                          {%- render 'blko-demo-card', index: 1, part: 'image', sizes: '96px' -%}
                        {%- endif -%}
                      </a>
                      <div class="blko-cart__info">
                        <a href="{{ item.url }}" class="blko-cart__name">{{ item.product.title | escape }}</a>
                        {%- unless item.product.has_only_default_variant -%}
                          <p class="blko-small blko-muted">{{ item.variant.title | escape }}</p>
                        {%- endunless -%}
                        {%- for property in item.properties -%}
                          {%- assign first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and first_char != '_' -%}
                            <p class="blko-small blko-muted">{{ property.first | escape }}: {{ property.last | escape }}</p>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if item.selling_plan_allocation -%}
                          <p class="blko-small blko-muted">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                        {%- endif -%}
                        <p class="blko-price">
                          {%- if item.original_price > item.final_price -%}
                            <span class="blko-visually-hidden">{{ 'blko.products.sale_price' | t }}</span>
                            <span class="blko-price__sale">{{ item.final_price | money }}</span>
                            <span class="blko-visually-hidden">{{ 'blko.products.regular_price' | t }}</span>
                            <s class="blko-price__compare">{{ item.original_price | money }}</s>
                          {%- else -%}
                            {{ item.final_price | money }}
                          {%- endif -%}
                        </p>
                        {%- for discount in item.line_level_discount_allocations -%}
                          <p class="blko-small blko-muted">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
                        {%- endfor -%}
                      </div>
                    </td>
                    <td class="blko-cart__qty-cell">
                      <div class="blko-cart__qty">
                        <button type="button" class="blko-cart__step" data-step="-1" aria-label="{{ 'blko.cart.decrease' | t: title: item_title }}">{% render 'blko-icon', name: 'minus' %}</button>
                        <label for="BlkoQty-{{ item.key | handle }}" class="blko-visually-hidden">{{ 'blko.cart.quantity_for' | t: title: item_title }}</label>
                        <input id="BlkoQty-{{ item.key | handle }}" class="blko-cart__qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                        <button type="button" class="blko-cart__step" data-step="1" aria-label="{{ 'blko.cart.increase' | t: title: item_title }}">{% render 'blko-icon', name: 'plus' %}</button>
                      </div>
                      <a href="{{ item.url_to_remove }}" class="blko-cart__remove">{{ 'blko.cart.remove' | t }}<span class="blko-visually-hidden"> {{ item.product.title | escape }}</span></a>
                    </td>
                    <td class="blko-cart__line">{{ item.final_line_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            <button type="submit" name="update" class="blko-btn blko-btn--ghost blko-btn--sm blko-cart__update">{{ 'blko.cart.update' | t }}</button>
          </div>

          <div class="blko-cart__summary">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'shipping_bar' -%}
                  {%- liquid
                    assign threshold = block.settings.threshold | default: 0 | times: 100
                    assign remaining = threshold | minus: cart.total_price
                    if threshold > 0
                      assign progress = cart.total_price | times: 100 | divided_by: threshold
                    else
                      assign progress = 100
                    endif
                    if progress > 100
                      assign progress = 100
                    endif
                  -%}
                  <div class="blko-cart__ship" {{ block.shopify_attributes }}>
                    <p class="blko-small">
                      {%- if remaining > 0 -%}
                        {%- assign remaining_money = remaining | money -%}
                        {{- block.settings.message | escape | replace: '[amount]', remaining_money -}}
                      {%- else -%}
                        {%- render 'blko-icon', name: 'truck' -%}
                        {{- block.settings.success | escape -}}
                      {%- endif -%}
                    </p>
                    <div class="blko-cart__ship-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="{{ 'blko.cart.shipping_progress' | t }}">
                      <span style="width: {{ progress }}%;"></span>
                    </div>
                  </div>
                {%- when 'note' -%}
                  <div class="blko-cart__note" {{ block.shopify_attributes }}>
                    <label for="BlkoCartNote" class="blko-small blko-medium">
                      {%- if block.settings.label != blank -%}{{ block.settings.label | escape }}{%- else -%}{{ 'blko.cart.note' | t }}{%- endif -%}
                    </label>
                    <textarea id="BlkoCartNote" name="note" class="blko-input blko-cart__note-input" rows="3"{% if block.settings.placeholder != blank %} placeholder="{{ block.settings.placeholder | escape }}"{% endif %}>{{ cart.note }}</textarea>
                  </div>
                {%- when 'subtotal' -%}
                  <div class="blko-cart__totals" {{ block.shopify_attributes }}>
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <p class="blko-cart__total-row blko-small"><span>{{ discount.title | escape }}</span><span>-{{ discount.total_allocated_amount | money }}</span></p>
                    {%- endfor -%}
                    <p class="blko-cart__total-row">
                      <span class="blko-medium">{{ 'blko.cart.subtotal' | t }}</span>
                      <span class="blko-price blko-price--lg">{{ cart.total_price | money_with_currency }}</span>
                    </p>
                    {%- if block.settings.show_tax_note or block.settings.shipping_note != blank -%}
                      <p class="blko-small blko-muted">
                        {%- if block.settings.show_tax_note -%}
                          {%- if cart.taxes_included -%}{{ 'blko.cart.taxes_included' | t }}{%- else -%}{{ 'blko.cart.taxes_excluded' | t }}{%- endif -%}
                        {%- endif -%}
                        {%- if block.settings.shipping_note != blank %} {{ block.settings.shipping_note | escape }}{%- endif -%}
                      </p>
                    {%- endif -%}
                  </div>
                {%- when 'text' -%}
                  {%- if block.settings.text != blank -%}
                    <div class="blko-rte blko-small blko-muted blko-cart__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
                  {%- endif -%}
                {%- when 'buttons' -%}
                  <div class="blko-cart__buttons" {{ block.shopify_attributes }}>
                    <button type="submit" name="checkout" class="blko-btn blko-btn--primary blko-btn--lg blko-btn--full">
                      {%- if block.settings.checkout_label != blank -%}{{ block.settings.checkout_label | escape }}{%- else -%}{{ 'blko.cart.checkout' | t }}{%- endif -%}
                    </button>
                    {%- if additional_checkout_buttons and block.settings.show_dynamic -%}
                      <div class="blko-cart__dynamic">{{ content_for_additional_checkout_buttons }}</div>
                    {%- endif -%}
                    {%- if block.settings.continue_label != blank -%}
                      <a href="{{ block.settings.continue_link | default: routes.all_products_collection_url }}" class="blko-text-link blko-cart__continue">{{ block.settings.continue_label | escape }}</a>
                    {%- endif -%}
                  </div>
                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </form>
      </blko-cart-form>
    {%- else -%}
      <div class="blko-cart__empty blko-cart__empty--{{ s.empty_alignment }}">
        {%- if s.empty_heading != blank -%}<h2 class="blko-h3">{{ s.empty_heading | escape }}</h2>{%- endif -%}
        {%- if s.empty_text != blank -%}<div class="blko-rte blko-body-lg blko-muted">{{ s.empty_text }}</div>{%- endif -%}
        {%- if s.empty_button_label != blank -%}
          <a href="{{ s.empty_button_link | default: routes.all_products_collection_url }}" class="blko-btn blko-btn--primary">{{ s.empty_button_label | escape }}</a>
        {%- endif -%}
        {%- if s.show_login_note and shop.customer_accounts_enabled and customer == null -%}
          <p class="blko-small blko-muted">{{ 'blko.cart.have_account_html' | t: url: routes.account_login_url }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign show_upsell = false
      if s.show_upsell
        if s.upsell_products != blank or s.upsell_collection != blank
          assign show_upsell = true
        endif
      endif
      if s.upsell_products != blank
        assign upsell_source = s.upsell_products
      else
        assign upsell_source = s.upsell_collection.products
      endif
      assign in_cart = ','
      for item in cart.items
        assign in_cart = in_cart | append: item.product_id | append: ','
      endfor
    -%}
    {%- if show_upsell -%}
      <div class="blko-cart__upsell">
        {%- if s.upsell_heading != blank -%}<h2 class="blko-h3">{{ s.upsell_heading | escape }}</h2>{%- endif -%}
        <ul class="blko-product-grid blko-product-grid--3 blko-product-grid--4 blko-cart__upsell-grid" role="list">
          {%- assign shown = 0 -%}
          {%- for product in upsell_source -%}
            {%- assign needle = ',' | append: product.id | append: ',' -%}
            {%- if in_cart contains needle -%}{%- continue -%}{%- endif -%}
            {%- if shown >= s.upsell_limit -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <li>
              {%- render 'blko-product-card', product: product, quick_add: s.upsell_quick_add, sizes: '(min-width: 1024px) 25vw, (min-width: 750px) 33vw, 50vw' -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif s.show_upsell and request.design_mode -%}
      <div class="blko-cart__upsell">
        {%- if s.upsell_heading != blank -%}<h2 class="blko-h3">{{ s.upsell_heading | escape }}</h2>{%- endif -%}
        <ul class="blko-product-grid blko-product-grid--3 blko-product-grid--4 blko-cart__upsell-grid" role="list">
          {%- for i in (1..s.upsell_limit) -%}
            <li>{%- render 'blko-demo-card', index: i -%}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .blko-cart__title { margin-bottom: 2rem; }
  .blko-cart__layout { display: grid; gap: 2.5rem; }
  .blko-cart__table { width: 100%; border-collapse: collapse; }
  .blko-cart__row td { padding-block: 1.25rem; vertical-align: top; }
  .blko-cart__row { display: grid; grid-template-columns: 1fr auto; gap: .75rem 1rem; }
  .blko-cart__product { grid-column: 1 / -1; display: flex; gap: 1rem; }
  .blko-cart__row td.blko-cart__product { padding-bottom: 0; }
  .blko-cart__row td.blko-cart__qty-cell, .blko-cart__row td.blko-cart__line { padding-top: 0; }
  .blko-cart__thumb { flex: 0 0 96px; width: 96px; height: 96px; }
  .blko-cart__info { display: grid; gap: .25rem; align-content: start; }
  .blko-cart__name { font-family: var(--font-body, Karla, sans-serif); font-weight: 500; font-size: 15px; text-decoration: none; }
  .blko-cart__name:hover { text-decoration: underline; text-underline-offset: 3px; }
  .blko-cart__qty-cell { display: flex; align-items: center; gap: 1rem; }
  .blko-cart__qty { display: inline-flex; align-items: center; border: 1px solid var(--color-border, #d6d1c0); border-radius: var(--radius-input, 0); }
  .blko-cart__step { display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .blko-cart__step svg { width: 14px; height: 14px; }
  .blko-cart__qty-input { width: 3rem; height: 40px; border: 0; background: transparent; text-align: center; font-variant-numeric: tabular-nums; -moz-appearance: textfield; }
  .blko-cart__qty-input::-webkit-inner-spin-button, .blko-cart__qty-input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .blko-cart__remove { font-size: var(--blko-text-small, 14px); color: var(--color-text-muted, #59625b); text-underline-offset: 3px; }
  .blko-cart__line { justify-self: end; align-self: center; font-variant-numeric: tabular-nums; font-weight: 500; }
  .blko-cart__update { margin-top: 1rem; }
  blko-cart-form[data-ready] .blko-cart__update { display: none; }
  .blko-cart__summary { display: grid; gap: 1rem; align-content: start; padding: 1.5rem; background: var(--color-bg-alt, #e4e0cc); border-radius: var(--radius-card, 0); }
  .blko-cart__note { display: grid; gap: .5rem; }
  .blko-cart__note-input { min-height: 88px; padding-block: .625rem; resize: vertical; }
  .blko-cart__total-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .blko-cart__continue { justify-self: center; }
  .blko-cart__empty { display: grid; justify-items: start; gap: 1.25rem; padding-block: 1rem 2rem; }
  @media (min-width: 750px) {
    .blko-cart__row { display: table-row; }
    .blko-cart__row td, .blko-cart__row td.blko-cart__product, .blko-cart__row td.blko-cart__qty-cell, .blko-cart__row td.blko-cart__line { display: table-cell; padding-block: 1.5rem; }
    .blko-cart__qty-cell { padding-inline: 1.5rem; }
    .blko-cart__qty-cell > * + * { margin-top: .5rem; }
    .blko-cart__remove { display: block; }
    .blko-cart__line { text-align: right; vertical-align: top; }
    .blko-cart__product { display: flex; }
  }
  @media (min-width: 1024px) {
    .blko-cart__layout { grid-template-columns: minmax(0, 1fr) 24rem; gap: 4rem; align-items: start; }
    .blko-cart__summary { position: sticky; top: 7rem; }
  }
  .blko-cart--outline .blko-cart__summary { background: transparent; border: 1px solid var(--color-border, #d6d1c0); }
  .blko-cart--plain .blko-cart__summary { background: transparent; padding: 0; }
  .blko-cart__totals, .blko-cart__buttons { display: grid; gap: 1rem; }
  .blko-cart__ship { display: grid; gap: .5rem; }
  .blko-cart__ship p { display: flex; align-items: center; gap: .5rem; }
  .blko-cart__ship svg { width: 1rem; height: 1rem; flex: none; }
  .blko-cart__ship-track { height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--color-text, #262f29) 12%, transparent); overflow: hidden; }
  .blko-cart__ship-track span { display: block; height: 100%; border-radius: inherit; background: var(--color-accent, #666237); }
  .blko-cart__table--no-thumbs .blko-cart__thumb { display: none; }
  .blko-cart__empty--center { justify-items: center; text-align: center; }
  .blko-cart__upsell { display: grid; gap: 1.5rem; margin-top: 4rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "blko-main-cart",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bag" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ],
      "default": "h2"
    },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show product images", "default": true },
    {
      "type": "select",
      "id": "summary_style",
      "label": "Summary style",
      "options": [
        { "value": "panel", "label": "Tinted panel" },
        { "value": "outline", "label": "Outlined" },
        { "value": "plain", "label": "Plain" }
      ],
      "default": "panel"
    },
    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_heading", "label": "Heading" },
    { "type": "richtext", "id": "empty_text", "label": "Text", "default": "<p>Your bag is empty.</p>" },
    { "type": "text", "id": "empty_button_label", "label": "Button label", "default": "Continue shopping" },
    { "type": "url", "id": "empty_button_link", "label": "Button link", "info": "Defaults to all products." },
    {
      "type": "select",
      "id": "empty_alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    { "type": "checkbox", "id": "show_login_note", "label": "Show log in note", "default": true },
    { "type": "header", "content": "Upsell products" },
    { "type": "checkbox", "id": "show_upsell", "label": "Show upsell products", "default": true },
    { "type": "text", "id": "upsell_heading", "label": "Heading", "default": "Pairs well with" },
    { "type": "collection", "id": "upsell_collection", "label": "Collection" },
    { "type": "product_list", "id": "upsell_products", "label": "Or pick products", "limit": 8, "info": "Overrides the collection." },
    { "type": "range", "id": "upsell_limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "upsell_quick_add", "label": "Show add to bag on cards", "default": true }
  ],
  "blocks": [
    {
      "type": "shipping_bar",
      "name": "Free shipping bar",
      "limit": 1,
      "settings": [
        { "type": "number", "id": "threshold", "label": "Free shipping threshold", "info": "In your store currency.", "default": 60 },
        { "type": "text", "id": "message", "label": "Progress message", "info": "[amount] shows what is left to spend.", "default": "You’re [amount] away from free shipping." },
        { "type": "text", "id": "success", "label": "Reached message", "default": "Your order ships free." }
      ]
    },
    {
      "type": "note",
      "name": "Order note",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Order note" },
        { "type": "text", "id": "placeholder", "label": "Placeholder" }
      ]
    },
    {
      "type": "subtotal",
      "name": "Subtotal",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note", "default": true },
        { "type": "text", "id": "shipping_note", "label": "Extra shipping note", "default": "Free shipping over $60. Returns within 30 days." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every order ships in recyclable packaging.</p>" }
      ]
    },
    {
      "type": "buttons",
      "name": "Checkout buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Check out" },
        { "type": "checkbox", "id": "show_dynamic", "label": "Show dynamic checkout buttons", "default": true },
        { "type": "text", "id": "continue_label", "label": "Continue link label", "default": "Continue shopping" },
        { "type": "url", "id": "continue_link", "label": "Continue link", "info": "Defaults to all products." }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
