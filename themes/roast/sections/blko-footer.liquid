{%- comment -%}
  Footer on a color scheme (Soft by default). Columns are blocks: brand, menu, text, newsletter, social.
  Empty menu blocks are skipped and the flex row closes the gap. Legal row: copyright, policies, payment icons.
{%- endcomment -%}
{%- liquid
  assign wordmark = settings.logo_text | default: shop.name
  assign any_social = false
  assign networks = 'instagram,facebook,tiktok,pinterest,youtube,x' | split: ','
  for n in networks
    assign key = 'social_' | append: n | append: '_link'
    if settings[key] != blank
      assign any_social = true
    endif
  endfor
-%}
<footer
  class="blko-footer blko-scheme color-{{ section.settings.color_scheme }}"
  style="--blko-footer-pt: {{ section.settings.padding_top }}px; --blko-footer-pb: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.blocks.size > 0 -%}
    <div class="blko-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="blko-footer__brand" {{ block.shopify_attributes }}>
              <a href="{{ routes.root_url }}" class="blko-footer__wordmark">
                {%- if block.settings.show_logo and settings.logo != blank -%}
                  {{ settings.logo | image_url: width: 400 | image_tag: class: 'blko-footer__logo', widths: '200, 300, 400', sizes: '160px', alt: wordmark, loading: 'lazy' }}
                {%- else -%}
                  {{ wordmark | escape }}
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}<div class="blko-muted blko-footer__rte">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.show_social -%}{%- render 'blko-social-icons', class: 'blko-footer__social' -%}{%- endif -%}
            </div>
          {%- when 'menu' -%}
            {%- if block.settings.menu.links.size == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign col_heading = block.settings.heading | default: block.settings.menu.title -%}
            <nav class="blko-footer__col" aria-label="{{ col_heading | escape }}" {{ block.shopify_attributes }}>
              {%- if col_heading != blank -%}<p class="blko-medium">{{ col_heading | escape }}</p>{%- endif -%}
              <ul class="blko-list-reset blko-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="blko-footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'text' -%}
            {%- if block.settings.heading == blank and block.settings.text == blank -%}{%- continue -%}{%- endif -%}
            <div class="blko-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="blko-medium">{{ block.settings.heading | escape }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="blko-muted blko-footer__rte">{{ block.settings.text }}</div>{%- endif -%}
            </div>
          {%- when 'social' -%}
            {%- unless any_social -%}{%- continue -%}{%- endunless -%}
            <div class="blko-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="blko-medium">{{ block.settings.heading | escape }}</p>{%- endif -%}
              {%- render 'blko-social-icons', class: 'blko-footer__social' -%}
            </div>
          {%- when 'newsletter' -%}
            <div class="blko-footer__col blko-footer__news" {{ block.shopify_attributes }}>
              {%- assign news_id = 'BlkoFooterNewsletter-' | append: block.id -%}
              {%- form 'customer', id: news_id, class: 'blko-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label for="BlkoFooterEmail-{{ block.id }}" class="blko-medium">{{ block.settings.heading | escape }}</label>
                {%- if block.settings.text != blank -%}<p class="blko-muted">{{ block.settings.text | escape }}</p>{%- endif -%}
                {%- if form.posted_successfully? -%}
                  <p class="blko-form-message" role="status">{{ 'blko.newsletter.success' | t }}</p>
                {%- else -%}
                  <div class="blko-field-row">
                    <input id="BlkoFooterEmail-{{ block.id }}" class="blko-input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'blko.newsletter.email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="BlkoFooterError-{{ block.id }}"{% endif %}>
                    <button type="submit" class="blko-btn blko-btn--primary">{%- if block.settings.button_label != blank -%}{{ block.settings.button_label | escape }}{%- else -%}{{ 'blko.newsletter.subscribe' | t }}{%- endif -%}</button>
                  </div>
                  {%- if form.errors -%}
                    <p id="BlkoFooterError-{{ block.id }}" class="blko-form-message blko-form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_legal -%}
    <div class="blko-footer__legal">
      <ul class="blko-list-reset blko-footer__policies">
        {%- if section.settings.show_copyright -%}
          <li>
            &copy; {{ 'now' | date: '%Y' }}
            <a href="{{ routes.root_url }}" class="blko-footer__link">{{ section.settings.copyright | default: wordmark | escape }}</a>
          </li>
        {%- endif -%}
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}" class="blko-footer__link">{{ policy.title | escape }}</a></li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
      {%- if section.settings.show_payment -%}
        {%- render 'blko-payment-marks', class: 'blko-footer__payments' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</footer>

{% stylesheet %}
  .blko-footer { font-size: var(--blko-text-small, 14px); }
  .blko-footer__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 1.5rem; max-width: var(--blko-page, 1280px); margin-inline: auto; padding: calc(var(--blko-footer-pt, 64px) * var(--blko-pad-k, 1)) var(--blko-gutter, 16px) calc(var(--blko-footer-pb, 64px) * var(--blko-pad-k, 1)); }
  .blko-footer__brand { grid-column: 1 / -1; display: grid; gap: .75rem; align-content: start; max-width: 18rem; }
  .blko-footer__wordmark { font-family: var(--font-heading, Georgia, serif); font-weight: var(--font-heading-weight, 500); font-size: var(--blko-text-h4, 20px); line-height: 1; text-decoration: none; }
  .blko-footer__logo { width: min(var(--logo-width, 140px), 160px); height: auto; }
  .blko-footer__rte > * + * { margin-top: .5rem; }
  .blko-footer__rte a { color: var(--color-text, #262f29); text-underline-offset: 3px; }
  .blko-footer__col { display: grid; gap: .75rem; align-content: start; }
  .blko-footer__links { display: grid; gap: .5rem; }
  .blko-footer__link { color: var(--color-text-muted, #59625b); text-decoration: none; transition: color .2s; }
  .blko-footer__link:hover { color: var(--color-text, #262f29); }
  .blko-footer__news { grid-column: 1 / -1; }
  .blko-footer__form { display: grid; gap: .75rem; }
  .blko-footer__social { display: flex; flex-wrap: wrap; gap: .25rem; margin-left: -.5rem; }
  .blko-footer__social .blko-social__link { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--color-text, #262f29); transition: background-color .2s; }
  .blko-footer__social .blko-social__link:hover { background: color-mix(in srgb, var(--color-text, #262f29) 8%, transparent); }
  .blko-footer__social svg { width: 18px; height: 18px; }
  .blko-footer__legal { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem 1.5rem; max-width: var(--blko-page, 1280px); margin-inline: auto; padding: 1.25rem var(--blko-gutter, 16px); border-top: 1px solid color-mix(in srgb, var(--color-text, #262f29) 15%, transparent); color: var(--color-text-muted, #59625b); }
  .blko-footer__policies { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .blko-footer__payments { display: flex; flex-wrap: wrap; gap: .375rem; }
  @media (min-width: 1024px) {
    /* Flex, not fixed tracks: a menu column without a menu is skipped and the rest close up. */
    .blko-footer__grid { display: flex; gap: 2.5rem; padding-inline: var(--blko-gutter, 32px); }
    .blko-footer__grid > * { flex: 1 1 0; min-width: 0; }
    .blko-footer__grid > .blko-footer__brand { flex-grow: 1.3; }
    .blko-footer__grid > .blko-footer__news { flex-grow: 1.6; }
    .blko-footer__legal { flex-direction: row; align-items: center; justify-content: space-between; padding-inline: var(--blko-gutter, 32px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "blko-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Legal row" },
    { "type": "checkbox", "id": "show_legal", "label": "Show legal row", "default": true },
    { "type": "checkbox", "id": "show_copyright", "label": "Show copyright", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright name", "info": "Leave empty to use the store wordmark." },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true, "info": "Policies are set in Settings › Policies." },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_logo", "label": "Show logo image", "default": false, "info": "Off shows the wordmark. Both are set in Theme settings › Logo." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Organic skincare, made in small batches.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": false, "info": "Links are set in Theme settings › Social media." }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop", "info": "Leave empty to use the menu title." },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer", "info": "A column with an empty menu is hidden." }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit the studio" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Open Tuesday to Saturday, 10 to 6.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join our newsletter" },
        { "type": "text", "id": "text", "label": "Text", "default": "New formulas and routines, twice a month." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
      ]
    },
    {
      "type": "social",
      "name": "Social icons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow along" },
        { "type": "paragraph", "content": "Links are set in Theme settings › Social media. The column is hidden until one is set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Studio" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
