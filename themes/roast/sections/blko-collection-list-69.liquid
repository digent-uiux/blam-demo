{%- liquid
  assign s = section.settings
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-collection-list-69.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-roast-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-roast-motion.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-roast', tokens: s.tokens -%}
{%- comment -%}
  Halden "Start somewhere else" (roast, 404): three offset collection tiles on 12 columns (big 4:5, 4:3 beside it under
  the heading, a 16:9 pulled up over the big tile's corner with a crema ring), each with a crema label plate.
{%- endcomment -%}
{%- capture body -%}
<div class="bcollectionlist69__grid"
  ><header class="bcollectionlist69__head"
    >{%- if s.eyebrow != blank -%}<p class="bcollectionlist69__label rm-rise bcollectionlist69__muted">{{ s.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="bcollectionlist69__title"
      ><span class="rm-mask"><span class="rm-line">{{ s.line_1 }}</span></span
      >{%- if s.line_2 != blank -%}<span class="rm-mask"><span class="rm-line" style="--d:100ms">{{ s.line_2 }}</span></span>{%- endif -%}
    </h2
    >{%- if s.link_label != blank -%}
    <a href="{{ s.link | default: routes.all_products_collection_url }}" class="bcollectionlist69__all"><span class="rm-ul">{{ s.link_label | escape }}</span>{%- render 'blko-ui-icon', name: 'arrow-right', className: 'rm-nudge' -%}</a
    >{%- endif -%}
  </header
  >{%- for b in section.blocks limit: 3 -%}
    {%- liquid
      assign c = collections[b.settings.collection]
      assign name = b.settings.label
      if name == blank and c != blank
        assign name = c.title
      endif
      assign im = b.settings.image
      if im == blank and c != blank
        assign im = c.featured_image
      endif
      assign url = routes.collections_url
      if c != blank
        assign url = c.url
      endif
      assign count = b.settings.count
      if count == blank and c != blank
        assign count = c.products_count | append: ' products'
      endif
      assign k = forloop.index0
    -%}
    <a href="{{ url }}" class="bcollectionlist69__tile bcollectionlist69__tile--{{ k }} rm-zoom rm-rise" style="--d:{{ k | times: 110 }}ms" {{ b.shopify_attributes }}
      >{%- if im != blank -%}
        {{ im | image_url: width: 1200 | image_tag: alt: im.alt, loading: 'lazy', widths: '400, 700, 900, 1200', class: 'bcollectionlist69__img' -}}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'bcollectionlist69__img' -}}
      {%- endif -%}
      <span class="bcollectionlist69__plate"
        ><span class="bcollectionlist69__pt"
          ><span class="bcollectionlist69__name"><span class="rm-roll"><span>{{ name | escape }}</span></span></span
          ><span class="bcollectionlist69__label bcollectionlist69__count">{{ count | escape }}</span
        ></span
        ><span aria-hidden="true" class="bcollectionlist69__arrow">{%- render 'blko-ui-icon', name: 'arrow-up-right' -%}</span
      ></span
    ></a
  >{%- endfor -%}
</div
>{%- endcapture -%}
<div class="bcollectionlist69" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-roast data-bcollectionlist69 data-rm-magnetic
  >{%- render 'blko-ui-section', surface: 'bg', label: s.label, inner: 'bcollectionlist69__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Collection list 69",
  "tag": "div",
  "class": "blko-bundle",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "Start somewhere else"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Lost the thread?"
    },
    {
      "type": "text",
      "id": "line_1",
      "label": "Heading line 1",
      "default": "Start somewhere"
    },
    {
      "type": "text",
      "id": "line_2",
      "label": "Heading line 2 (wrap a word in <em>)",
      "default": "<em>else</em>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop everything"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Roast)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (blank = collection title)",
          "default": "Coffee"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (blank = collection image)"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Count label (blank = product count)",
          "default": "24 roasts"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list 69",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "Coffee",
            "count": "24 roasts"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Tea & matcha",
            "count": "16 teas"
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Brew gear",
            "count": "19 tools"
          }
        }
      ]
    }
  ]
}
{% endschema %}
