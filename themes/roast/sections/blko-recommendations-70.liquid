{%- liquid
  assign s = section.settings
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-recommendations-70.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-roast-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-roast-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-recommendations-70.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-roast', tokens: s.tokens -%}
{%- liquid
  assign has_recs = false
  if recommendations.performed and recommendations.products_count > 0
    assign has_recs = true
  endif
  assign rec_pid = ''
  if product != blank
    assign rec_pid = product.id
  elsif cart.item_count > 0
    assign rec_pid = cart.items.first.product_id
  endif
-%}
{%- capture body -%}
  <div class="brecommendations70__wrap"
    ><header class="brecommendations70__head"
      ><p class="brecommendations70__label rm-rise brecommendations70__kicker"><span aria-hidden="true" class="brecommendations70__dot"></span>{{ s.kicker | escape }}</p
      ><h2 class="brecommendations70__h2"><span class="rm-mask"><span class="rm-line" style="--d:0ms">{{ s.heading | escape }}</span></span><span class="rm-mask"><span class="rm-line" style="--d:100ms"><em>{{ s.accent | escape }}</em></span></span></h2
      ><p class="rm-rise brecommendations70__text" style="--d:200ms">{{ s.text | escape }}</p
      ><div class="rm-rise brecommendations70__ctrl" style="--d:280ms"
        ><button type="button" data-go="-1" disabled aria-label="{{ 'blko.recommendations_70.prev' | t }}" class="brecommendations70__arrow">{%- render 'blko-ui-icon', name: 'arrow-left', size: 16, className: 'rm-nudge' -%}</button
        ><button type="button" data-go="1" aria-label="{{ 'blko.recommendations_70.next' | t }}" class="brecommendations70__arrow">{%- render 'blko-ui-icon', name: 'arrow-right', size: 16, className: 'rm-nudge' -%}</button
        ><span class="brecommendations70__label brecommendations70__drag">{%- render 'blko-ui-icon', name: 'move-horizontal', size: 14 -%} {{ 'blko.recommendations_70.drag' | t }}</span
      ></div
    ></header
    ><div class="brecommendations70__railbox"
      ><ul tabindex="0" aria-label="{{ 'blko.recommendations_70.rail' | t }}" class="brecommendations70__rail" data-rail
        >{%- if has_recs -%}
          {%- for p in recommendations.products limit: 6 -%}
            {%- liquid
              assign line = p.metafields.custom.short_description.value | default: p.description | strip_html | truncatewords: 10
              assign v = p.selected_or_first_available_variant
            -%}
            {%- render 'blko-recommendations-70-card', i: forloop.index0, title: p.title, kicker: p.type, line: line, cents: p.price, image: p.featured_image, href: p.url, variant: v.id, attrs: '' -%}
          {%- endfor -%}
        {%- else -%}
          {%- for b in section.blocks -%}
            {%- liquid
              assign d = b.settings
              assign t = d.title
              assign k = d.kicker
              assign line = d.line
              assign c = d.price | times: 100 | round
              assign im = d.image
              assign href = '#'
              assign vid = ''
              if d.product != blank
                assign t = d.product.title
                assign c = d.product.price
                assign im = d.product.featured_image
                assign href = d.product.url
                assign vid = d.product.selected_or_first_available_variant.id
              endif
            -%}
            {%- render 'blko-recommendations-70-card', i: forloop.index0, title: t, kicker: k, line: line, cents: c, image: im, href: href, variant: vid, attrs: b.shopify_attributes -%}
          {%- endfor -%}
        {%- endif -%}
      </ul
      ><div aria-hidden="true" class="brecommendations70__track"><span data-bar style="transform:scaleX(0.15)"></span></div
    ></div
  ></div
>{%- endcapture -%}
<div class="brecommendations70" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-roast data-rm-magnetic data-l-add="{{ 'blko.recommendations_70.add' | t }}" data-l-added="{{ 'blko.recommendations_70.added' | t }}"{% if has_recs == false and s.auto and rec_pid != '' %} data-recs="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ rec_pid }}&limit=6&intent=complementary"{% endif %}
  >{%- render 'blko-ui-section', surface: 'pop-2', bleed: true, full: true, label: s.label, className: 'brecommendations70__band', children: body -%}
</div

>

{% schema %}
{
  "name": "Recommendations, add-ons",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cards come from Shopify's complementary recommendations for the product (or the first cart item) when there are any; the cards below fill in otherwise. The line reads the custom.short_description metafield, else the description."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Region label",
      "default": "Pairs well with"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Before you check out"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well"
    },
    {
      "type": "text",
      "id": "accent",
      "label": "Heading, accent line",
      "default": "with"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Three small things our bar team reaches for. One tap adds them to this order."
    },
    {
      "type": "checkbox",
      "id": "auto",
      "label": "Use product recommendations",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "tokens",
      "label": "Colors, fonts, corners",
      "options": [
        {
          "value": "preset",
          "label": "Bundled preset (Roast)"
        },
        {
          "value": "theme",
          "label": "Read the theme's tokens"
        }
      ],
      "default": "preset",
      "info": "Reads the design tokens a Blocko theme sets (--blko-color-bg, --blko-font-heading, --blko-radius-card, --blko-theme-button-case…)."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80,
      "info": "Phones use 70%."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Add-on",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Bar gear"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name (no product)",
          "default": "Stacking bar cups, set of 4"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Line",
          "default": "Speckled stoneware, 180 ml, made to nest."
        },
        {
          "type": "number",
          "id": "price",
          "label": "Price (no product)",
          "default": 38
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (no product)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recommendations, add-ons",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "kicker": "Bar gear",
            "title": "Stacking bar cups, set of 4",
            "line": "Speckled stoneware, 180 ml, made to nest.",
            "price": 38
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Tea kit",
            "title": "Ceremonial matcha kit",
            "line": "30 g Uji matcha, a bamboo whisk and a bowl.",
            "price": 64
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Loose leaf",
            "title": "Loose tea sampler, 6 jars",
            "line": "Black, green, oolong and three tisanes, 25 g each.",
            "price": 28
          }
        }
      ]
    }
  ],
  "class": "blko-bundle"
}
{% endschema %}
