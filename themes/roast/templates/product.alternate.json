        "review-9": {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Hedda L.",
            "title": "Blueberry muffin in a cup",
            "body": "Third bag now. As a pour-over at 1:16 it tastes like blueberry jam on toast, then something floral once it cools. Rest it a week; it's quiet the first few days.",
            "grind": "Whole bean · Cone dripper",
            "date": "Oct 21, 2026",
            "helpful": 48
          }
        },
        "review-10": {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Tomás R.",
            "title": "The one that made me buy a grinder",
            "body": "I didn't believe the notes until I tried it side by side with a supermarket bag. Sweet, juicy, no bitterness at all.",
            "grind": "Filter grind · Glass brewer",
            "date": "Oct 9, 2026",
            "helpful": 31,
            "dark": true
          }
        },
        "review-11": {
          "type": "review",
          "settings": {
            "stars": 4,
            "name": "Priya S.",
            "title": "Wild as espresso, lovely as milk drink",
            "body": "Straight shots are a lot of fruit for me; as a flat white it's like strawberry milk. Took four shots to dial in at 18 in, 40 out.",
            "grind": "Espresso grind",
            "date": "Oct 17, 2026",
            "helpful": 22
          }
        },
        "review-12": {
          "type": "review",
          "settings": {
            "stars": 5,
            "name": "Elliot H.",
            "title": "Smells incredible when you open the bag",
            "body": "Even the French press, which usually muddies everything, keeps the cacao and berry clear. Subscribed every 3 weeks.",
            "grind": "French press grind",
            "date": "Oct 26, 2026",
            "helpful": 12
          }
        }
