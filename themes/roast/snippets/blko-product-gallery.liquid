{%- comment -%}
  Product gallery for blko-main-product. Works with images, videos, external videos and 3D models.
  Without JS every media item is shown (thumb layouts stack them; the lightbox and hover zoom do nothing).

  Accepts:
  - product: {Object}
  - layout: {String} 'thumbs_left' | 'thumbs_below' | 'stack' | 'grid'
  - ratio: {String} 'adapt' | 'portrait' | 'square' | 'tall'
  - zoom: {String} 'lightbox' | 'hover' | 'off'
  - featured_media_id: {Number} media shown first / active
  - media_width: {Number} share of the row on desktop, in %
{%- endcomment -%}
{%- liquid
  assign per_slide_ratio = false
  case ratio
    when 'square'
      assign ratio_value = '1 / 1'
    when 'tall'
      assign ratio_value = '3 / 4'
    when 'adapt'
      assign ratio_value = product.featured_media.preview_image.aspect_ratio | default: 0.8
      if layout == 'stack' or layout == 'grid'
        assign per_slide_ratio = true
      endif
    else
      assign ratio_value = '4 / 5'
  endcase

  assign has_thumbs = false
  if layout == 'thumbs_left' or layout == 'thumbs_below'
    if product.media.size > 1
      assign has_thumbs = true
    endif
  endif

  assign media_width = media_width | default: 60
  if layout == 'grid'
    assign slide_vw = media_width | divided_by: 2
  else
    assign slide_vw = media_width
  endif
  assign slide_sizes = '(min-width: 750px) ' | append: slide_vw | append: 'vw, 100vw'

  assign image_media = product.media | where: 'media_type', 'image'
  assign model_media = product.media | where: 'media_type', 'model'
-%}
<blko-product-gallery
  class="blko-pdp__gallery blko-pdp__gallery--{{ layout }}"
  data-layout="{{ layout }}"
  data-zoom="{{ zoom }}"
  style="--blko-ratio: {{ ratio_value }};"
>
  <div class="blko-pdp__stage">
    {%- for media in product.media -%}
      {%- liquid
        assign is_active = false
        if media.id == featured_media_id
          assign is_active = true
        endif
        if is_active
          assign media_loading = 'eager'
        else
          assign media_loading = 'lazy'
        endif
        assign media_alt = media.alt | default: product.title
      -%}
      <div
        class="blko-media blko-pdp__slide blko-pdp__slide--{{ media.media_type }}{% if is_active %} is-active{% endif %}"
        data-media-id="{{ media.id }}"
        {% if per_slide_ratio %}
          style="--blko-ratio: {{ media.preview_image.aspect_ratio | default: 1 }};"
        {% endif %}
      >
        {%- case media.media_type -%}
          {%- when 'image' -%}
            {%- capture media_img -%}
              {%- if is_active -%}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    widths: '540, 720, 960, 1200, 1500, 1800',
                    sizes: slide_sizes,
                    loading: media_loading,
                    fetchpriority: 'high',
                    alt: media_alt,
                    class: 'blko-pdp__img'
                }}
              {%- else -%}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    widths: '540, 720, 960, 1200, 1500, 1800',
                    sizes: slide_sizes,
                    loading: media_loading,
                    alt: media_alt,
                    class: 'blko-pdp__img'
                }}
              {%- endif -%}
            {%- endcapture -%}
            {%- if zoom == 'lightbox' -%}
              <button
                type="button"
                class="blko-pdp__zoom"
                data-blko-zoom="{{ media.id }}"
                aria-label="{{ 'blko.product.zoom' | t: index: forloop.index }}"
              >
                {{- media_img -}}
              </button>
            {%- else -%}
              {{ media_img }}
            {%- endif -%}
          {%- when 'video' -%}
            {{ media | video_tag: controls: true, playsinline: true, image_size: '1200x' }}
          {%- when 'external_video' -%}
            {{ media | external_video_tag: loading: 'lazy' }}
          {%- when 'model' -%}
            {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
        {%- endcase -%}
      </div>
    {%- else -%}
      <div class="blko-media blko-pdp__slide is-active">
        {%- render 'blko-demo-card', index: 1, part: 'image', sizes: '(min-width: 1024px) 55vw, 100vw' -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if has_thumbs -%}
    <div class="blko-pdp__thumbs">
      {%- for media in product.media -%}
        <button
          type="button"
          class="blko-pdp__thumb"
          data-media-id="{{ media.id }}"
          aria-label="{{ 'blko.product.show_media' | t: index: forloop.index }}"
          aria-pressed="{% if media.id == featured_media_id %}true{% else %}false{% endif %}"
        >
          {%- if media.preview_image -%}
            {{
              media.preview_image
              | image_url: width: 240
              | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: ''
            }}
          {%- endif -%}
          {%- unless media.media_type == 'image' -%}
            <span class="blko-pdp__thumb-badge" aria-hidden="true">{% render 'blko-icon', name: 'play' %}</span>
          {%- endunless -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if model_media.size > 0 -%}
    <button
      type="button"
      class="blko-btn blko-btn--outline blko-btn--sm blko-pdp__xr"
      data-shopify-xr
      data-shopify-model3d-id="{{ model_media.first.id }}"
      data-shopify-title="{{ product.title | escape }}"
      data-shopify-xr-hidden
    >
      {{- 'blko.product.view_in_space' | t -}}
    </button>
    <script type="application/json" data-blko-models>
      {{ model_media | json }}
    </script>
  {%- endif -%}

  {%- if zoom == 'lightbox' and image_media.size > 0 -%}
    <dialog class="blko-pdp__lightbox" aria-label="{{ 'blko.product.media_gallery' | t }}" data-blko-lightbox>
      <button
        type="button"
        class="blko-btn blko-btn--outline blko-btn--icon blko-pdp__dialog-close"
        data-blko-close
        aria-label="{{ 'blko.general.close' | t }}"
      >
        {%- render 'blko-icon', name: 'close' -%}
      </button>
      <div class="blko-pdp__lightbox-list">
        {%- for media in image_media -%}
          <figure class="blko-pdp__lightbox-item" data-media-id="{{ media.id }}">
            {{
              media
              | image_url: width: 2400
              | image_tag:
                loading: 'lazy',
                widths: '960, 1400, 1800, 2400',
                sizes: '(min-width: 1200px) 1100px, 100vw',
                alt: media.alt
            }}
          </figure>
        {%- endfor -%}
      </div>
    </dialog>
  {%- endif -%}
</blko-product-gallery>
