{%- comment -%}
  GENERATED by liquid/_tools/sync-theme.py from liquid/_demo/<id>.json, do not edit.
  Demo product card (same markup as blko-product-card), shown when no product is picked or a collection is empty.
  Accepts: index {Number} 1-based, wraps; quick_add {Boolean}; show_rating {Boolean}; sizes {String}; part {String} 'image', 'title' or 'price'
{%- endcomment -%}
{%- liquid
  assign show_rating = show_rating | default: settings.card_show_rating, allow_false: true
  assign n = index | default: 1 | minus: 1 | modulo: 12 | plus: 1
  case n
    when 1
      assign image = 'product-1'
      assign price = 3400
      assign compare = 0
      assign rating = 4.8
      assign count = 120
    when 2
      assign image = 'product-2'
      assign price = 1800
      assign compare = 2400
      assign rating = 4.8
      assign count = 137
    when 3
      assign image = 'product-3'
      assign price = 4200
      assign compare = 0
      assign rating = 4.8
      assign count = 154
    when 4
      assign image = 'product-4'
      assign price = 3800
      assign compare = 0
      assign rating = 4.8
      assign count = 171
    when 5
      assign image = 'product-5'
      assign price = 2200
      assign compare = 0
      assign rating = 4.8
      assign count = 188
    when 6
      assign image = 'product-6'
      assign price = 2600
      assign compare = 0
      assign rating = 4.8
      assign count = 205
    when 7
      assign image = 'product-1'
      assign price = 4800
      assign compare = 5600
      assign rating = 4.8
      assign count = 222
    when 8
      assign image = 'product-2'
      assign price = 3600
      assign compare = 0
      assign rating = 4.8
      assign count = 239
    when 9
      assign image = 'product-3'
      assign price = 2400
      assign compare = 0
      assign rating = 4.8
      assign count = 256
    when 10
      assign image = 'product-4'
      assign price = 5800
      assign compare = 7200
      assign rating = 4.8
      assign count = 273
    when 11
      assign image = 'product-5'
      assign price = 4400
      assign compare = 0
      assign rating = 4.8
      assign count = 290
    when 12
      assign image = 'product-6'
      assign price = 6400
      assign compare = 0
      assign rating = 4.8
      assign count = 307
  endcase
  assign key = 'blko.demo.product_' | append: n
-%}
{%- if part == 'image' -%}{%- render 'blko-fallback-image', name: image, sizes: sizes -%}{%- elsif part == 'title' -%}{{ key | t }}{%- elsif part == 'price' -%}<span class="blko-price">{{ price | money }}</span>{%- else -%}
<div class="blko-card blko-card--demo">
  <div class="blko-media blko-media--card blko-card__media">
    {%- render 'blko-fallback-image', name: image, sizes: sizes -%}
  </div>
  {%- if compare > price -%}<span class="blko-badge blko-badge--sale blko-card__badge">{{ 'blko.products.sale' | t }}</span>{%- endif -%}
  <div class="blko-card__info">
    <h3 class="blko-card__title"><a href="{{ routes.all_products_collection_url }}">{{ key | t }}</a></h3>
    {%- if show_rating and rating > 0 -%}{%- render 'blko-rating', value: rating, count: count, size: 'xs' -%}{%- endif -%}
    <span class="blko-price">
      {%- if compare > price -%}
        <span class="blko-visually-hidden">{{ 'blko.products.sale_price' | t }}</span>
        <span class="blko-price__sale">{{ price | money }}</span>
        <span class="blko-visually-hidden">{{ 'blko.products.regular_price' | t }}</span>
        <s class="blko-price__compare">{{ compare | money }}</s>
      {%- else -%}{{ price | money }}{%- endif -%}
    </span>
  </div>
  {%- if quick_add -%}
    <div class="blko-card__action">
      <a href="{{ routes.all_products_collection_url }}" class="blko-btn blko-btn--outline blko-btn--sm blko-btn--full">{{ 'blko.products.add_to_cart' | t }}</a>
    </div>
  {%- endif -%}
</div>
{%- endif -%}
