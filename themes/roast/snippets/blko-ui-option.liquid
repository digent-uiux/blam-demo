{%- comment -%}option.Chip(selected, soldOut, children, className): product option, distinct from badge.Chip. Parent data-blko-ui-options makes selection exclusive.{%- endcomment -%}
<button type="button" class="blko-ui-option{% if soldOut %} blko-ui-option--sold-out{% endif %} {{ className }}" aria-pressed="{% if selected %}true{% else %}false{% endif %}"{% if soldOut %} aria-disabled="true"{% endif %}{% if disabled %} disabled{% endif %}{% if name != blank %} name="{{ name | escape }}"{% endif %}{% if value != nil %} value="{{ value | escape }}"{% endif %} data-blko-ui-option>{{ children }}</button>
