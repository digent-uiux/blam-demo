{%- comment -%}
  GENERATED by liquid/_tools/sync-theme.py from liquid/_demo/<id>.json, do not edit.
  Demo blog card (same markup as blko-blog-posts) for blog sections with no blog or no articles.
  Accepts: index {Number} 1-based, wraps; show_image, show_date, show_excerpt {Boolean, default true}; sizes {String};
  media_class {String}; part {String} 'image' or 'title' for the photo or title alone
{%- endcomment -%}
{%- liquid
  assign show_image = show_image | default: true, allow_false: true
  assign show_date = show_date | default: true, allow_false: true
  assign show_excerpt = show_excerpt | default: true, allow_false: true
  assign n = index | default: 1 | minus: 1 | modulo: 3 | plus: 1
  case n
    when 1
      assign image = 'lifestyle-1'
      assign date = '2026-10-21'
    when 2
      assign image = 'lifestyle-2'
      assign date = '2026-10-09'
    when 3
      assign image = 'lifestyle-1'
      assign date = '2026-09-30'
  endcase
  assign key = 'blko.demo.article_' | append: n
-%}
{%- case part -%}
  {%- when 'image' -%}{%- render 'blko-fallback-image', name: image, sizes: sizes -%}
  {%- when 'title' -%}{{ key | append: '_title' | t }}
  {%- else -%}
<article class="blko-posts__card">
  {%- if show_image -%}
    <div class="blko-media {{ media_class }} blko-posts__media">{%- render 'blko-fallback-image', name: image, sizes: sizes -%}</div>
  {%- endif -%}
  <div class="blko-posts__info">
    {%- if show_date -%}<p class="blko-small blko-muted blko-posts__meta">{{ date | date: '%b %-d, %Y' }}</p>{%- endif -%}
    <h3 class="blko-posts__title"><a href="{{ blogs.news.url | default: routes.root_url }}">{{ key | append: '_title' | t }}</a></h3>
    {%- if show_excerpt -%}<p class="blko-small blko-muted blko-pretty">{{ key | append: '_excerpt' | t }}</p>{%- endif -%}
  </div>
</article>
{%- endcase -%}
