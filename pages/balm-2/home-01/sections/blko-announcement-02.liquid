{%- comment -%}
  Announcement 02, "Pop with link": a soft strip with a bold line and a small dark pill link whose round arrow turns on hover.
  Works in any Online Store 2.0 theme: every class is blko-ann02-, every colour, size and text is a section setting.
{%- endcomment -%}
{{ 'blko-announcement-02.css' | asset_url | stylesheet_tag }}
{%- render 'blko-h01-fonts', source: section.settings.font_source, heading_font: section.settings.heading_font, body_font: section.settings.body_font -%}

{%- liquid
  assign s = section.settings
  case s.font_source
    when 'theme'
      assign body_family = 'var(--font-body-family, inherit)'
    when 'picker'
      assign body_family = s.body_font.family | append: ', ' | append: s.body_font.fallback_families
    else
      assign body_family = "'blko-h01 Schibsted Grotesk', system-ui, sans-serif"
  endcase
  assign url = s.link_url | default: routes.all_products_collection_url
-%}

<div
  class="blko-ann02"
  role="region"
  aria-label="{{ 'blko.announcement_02.label' | t | escape }}"
  style="
    --blko-ann02-body-font: {{ body_family }};
    --blko-ann02-bg: {{ s.color_bg }}; --blko-ann02-text: {{ s.color_text }};
    --blko-ann02-pill: {{ s.color_pill }}; --blko-ann02-pill-label: {{ s.color_pill_label }};
    --blko-ann02-radius: {{ s.radius_pill }}px; --blko-ann02-h: {{ s.min_height }}px; --blko-ann02-size: {{ s.text_size }}px;
  "
>
  <div class="blko-ann02__inner">
    {%- if s.text != blank -%}
      <span class="blko-ann02__text">{{ s.text }}</span>
    {%- endif -%}
    {%- if s.link_label != blank -%}
      <a href="{{ url }}" class="blko-ann02__pill">
        {{- s.link_label | escape -}}
        <span class="blko-ann02__chip" aria-hidden="true">
          {%- render 'blko-ann02-icon', name: 'arrow-up-right', class: 'blko-ann02__icon' -%}
        </span>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement, pill link",
  "tag": "div",
  "class": "blko-ann02-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "<strong>New:</strong> the Barrier Repair collection is here.", "info": "Use bold for the lead word." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now", "info": "Leave empty to hide the pill." },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Defaults to all products." },
    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "font_source",
      "label": "Fonts",
      "options": [
        { "value": "bundled", "label": "Bundled (Schibsted Grotesk)" },
        { "value": "picker", "label": "Pick from the font library" },
        { "value": "theme", "label": "Use the theme's fonts" }
      ],
      "default": "bundled"
    },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n4", "info": "Used when Fonts is set to the font library." },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4", "info": "Used when Fonts is set to the font library." },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Height", "min": 32, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "radius_pill", "label": "Pill corners", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 20 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#ebe5da" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#1d2421" },
    { "type": "color", "id": "color_pill", "label": "Pill", "default": "#1d2421" },
    { "type": "color", "id": "color_pill_label", "label": "Pill label and arrow", "default": "#ebe5da" }
  ],
  "presets": [{ "name": "Announcement, pill link" }]
}
{% endschema %}
