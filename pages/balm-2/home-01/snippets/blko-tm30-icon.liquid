{%- comment -%}
  Lucide icons for Testimonial 30 (ISC licence, lucide.dev), 24px grid, currentColor.
  Accepts:
  - name: {String} 'arrow-right'
  - class: {String} optional extra class
{%- endcomment -%}
<svg class="blko-tm30__icon{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'arrow-right' -%}<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
  {%- endcase -%}
</svg>
