{%- comment -%}
  Lucide icons for Newsletter 40 (ISC licence, lucide.dev), 24px grid, currentColor.
  Accepts:
  - name: {String} 'check'
  - class: {String} optional extra class
{%- endcomment -%}
<svg class="blko-nl40__icon{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
</svg>
