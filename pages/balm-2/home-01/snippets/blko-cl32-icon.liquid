{%- comment -%}
  Lucide icons for Collection list 32 (ISC licence, lucide.dev), 24px grid, currentColor.
  Accepts:
  - name: {String} 'plus' or 'check'
  - class: {String} optional extra class
{%- endcomment -%}
<svg class="blko-cl32__icon{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'plus' -%}<path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
</svg>
