{%- comment -%} Ingredient grid (Soft scheme by default): heading + side note, ingredient blocks (image, % badge, name, text), full list in a disclosure. {%- endcomment -%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-ingr"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px; --blko-ingr-cols: {{ section.settings.columns }};"
>
  <div class="blko-container">
    <div class="blko-ingr__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="blko-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="blko-small blko-muted blko-ingr__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="blko-ingr__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="blko-ingr__item" {{ block.shopify_attributes }}>
          {%- if section.settings.show_images -%}
          <div class="blko-media blko-media--{{ section.settings.image_ratio }} blko-ingr__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw', widths: '400, 600, 800' }}
            {%- else -%}
              {%- assign ph = 'aloe,oats,orange,lavender' | split: ',' -%}
              {%- assign ph_i = forloop.index0 | modulo: 4 -%}
              {%- render 'blko-fallback-image', name: ph[ph_i] -%}
            {%- endif -%}
            {%- if block.settings.amount != blank -%}
              <span class="blko-ingr__badge">{{ block.settings.amount | escape }}</span>
            {%- endif -%}
          </div>
          {%- elsif block.settings.amount != blank -%}
            <span class="blko-ingr__badge blko-ingr__badge--inline">{{ block.settings.amount | escape }}</span>
          {%- endif -%}
          <div class="blko-ingr__info">
            <h3 class="blko-h4">{{ block.settings.name | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="blko-small blko-muted">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_list and section.settings.list_label != blank and section.settings.list != blank -%}
      <details class="blko-ingr__details"{% if section.settings.list_open %} open{% endif %}>
        <summary class="blko-ingr__summary">
          {{- section.settings.list_label | escape -}}
          <span class="blko-ingr__plus" aria-hidden="true">+</span>
        </summary>
        <div class="blko-ingr__list blko-small blko-muted">{{ section.settings.list }}</div>
      </details>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .blko-ingr__head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .blko-ingr__note { max-width: 28rem; }
  .blko-ingr__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem 1rem; list-style: none; margin: 0; padding: 0; }
  .blko-ingr__item { display: grid; align-content: start; gap: 1rem; }
  .blko-ingr__media img { transition: transform .5s cubic-bezier(.16, 1, .3, 1); }
  .blko-ingr__item:hover .blko-ingr__media img { transform: scale(1.05); }
  .blko-ingr__badge { position: absolute; top: .75rem; left: .75rem; padding: .25rem .625rem; border-radius: 999px; background: color-mix(in srgb, var(--color-bg, #f6f2ea) 90%, transparent); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; line-height: 1.3; font-variant-numeric: tabular-nums; }
  .blko-ingr__badge--inline { position: static; justify-self: start; background: var(--color-bg-alt, #e4e0cc); }
  .blko-ingr__head h2 em { font-style: var(--heading-italic, italic); }
  .blko-ingr__info { display: grid; gap: .25rem; }
  .blko-ingr__details { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border, #d6d1c0); font-size: var(--blko-text-small); }
  .blko-ingr__summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 500; cursor: pointer; list-style: none; }
  .blko-ingr__summary::-webkit-details-marker { display: none; }
  .blko-ingr__plus { font-size: var(--blko-text-h4); line-height: 1; color: var(--color-text-muted, #59625b); transition: transform .2s; }
  .blko-ingr__details[open] .blko-ingr__plus { transform: rotate(45deg); }
  .blko-ingr__list { max-width: 48rem; margin-top: .75rem; }
  @media (min-width: 640px) { .blko-ingr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .blko-ingr__head { grid-template-columns: 1fr 1fr; align-items: end; }
    .blko-ingr__note { justify-self: end; }
    .blko-ingr__grid { grid-template-columns: repeat(var(--blko-ingr-cols, 4), minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "blko-ingr-section",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Four ingredients doing the heavy lifting" },
    { "type": "textarea", "id": "note", "label": "Side note", "default": "Every ingredient is listed with its concentration. No fillers, no synthetic fragrance, nothing hidden behind “parfum”." },
    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns", "label": "Columns on large screens", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_images", "label": "Show images", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    { "type": "header", "content": "Full list" },
    { "type": "checkbox", "id": "show_list", "label": "Show full ingredient list", "default": true },
    { "type": "checkbox", "id": "list_open", "label": "Open by default", "default": false },
    { "type": "text", "id": "list_label", "label": "Disclosure label", "default": "Full ingredient list" },
    { "type": "richtext", "id": "list", "label": "Full ingredient list", "default": "<p>Aloe Barbadensis Leaf Juice, Aqua, Glycerin, Avena Sativa Kernel Flour, Squalane, Citrus Aurantium Dulcis Peel Oil, Niacinamide, Sodium Hyaluronate, Lavandula Angustifolia Oil, Xanthan Gum, Tocopherol, Citric Acid, Linalool.</p>" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "amount", "label": "Concentration", "default": "40%" },
        { "type": "text", "id": "name", "label": "Name", "default": "Aloe vera" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Cold-pressed leaf juice that cools and calms redness on contact." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "amount": "40%", "name": "Aloe vera", "text": "Cold-pressed leaf juice that cools and calms redness on contact." } },
        { "type": "ingredient", "settings": { "amount": "5%", "name": "Colloidal oat", "text": "Finely milled oats soothe itch and help skin hold on to water." } },
        { "type": "ingredient", "settings": { "amount": "2%", "name": "Sweet orange", "text": "A gentle source of vitamin C that brightens dull, tired skin." } },
        { "type": "ingredient", "settings": { "amount": "0.5%", "name": "Lavender", "text": "Steam-distilled flowers for a soft scent that winds you down." } }
      ]
    }
  ]
}
{% endschema %}
