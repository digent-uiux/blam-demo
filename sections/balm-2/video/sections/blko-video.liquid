{%- comment -%}
  Video: a Shopify-hosted video or a YouTube/Vimeo link behind a cover image with a play button.
  Autoplay (hosted video only) plays muted and looped without controls. The player loads on click (blko-video.js).
{%- endcomment -%}
{%- liquid
  assign video = section.settings.video
  assign video_url = section.settings.video_url
  assign has_video = false
  if video != blank or video_url != blank
    assign has_video = true
  endif
  assign autoplay = false
  if section.settings.autoplay and video != blank
    assign autoplay = true
  endif
  assign cover = section.settings.cover_image
  if cover == blank and video != blank
    assign cover = video.preview_image
  endif
  assign default_label = 'blko.video.label' | t
  assign label = section.settings.heading | strip_html | default: default_label
-%}
{%- if has_video and autoplay == false -%}
  <script src="{{ 'blko-video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-video{% if section.settings.full_width %} blko-video--full{% endif %}"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px; --blko-video-ratio: {{ section.settings.ratio }};"
>
  {%- if section.settings.heading != blank or section.settings.text != blank -%}
    <div class="blko-container">
      <div class="blko-video__head{% if section.settings.heading_alignment == 'center' %} blko-video__head--center{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="blko-body blko-muted blko-pretty blko-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="{% unless section.settings.full_width %}blko-container{% endunless %}">
    <div class="blko-media blko-video__frame">
      {%- if autoplay -%}
        {{ video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, image_size: '1600x', class: 'blko-video__player' }}
      {%- else -%}
        <blko-video class="blko-video__poster">
          {%- if cover != blank -%}
            {%- assign cover_alt = cover.alt | escape -%}
            {{ cover | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000', alt: cover_alt, class: 'blko-video__cover' }}
          {%- else -%}
            {%- render 'blko-fallback-image', name: section.settings.fallback_image, class: 'blko-video__cover', sizes: '100vw' -%}
          {%- endif -%}
          {%- if has_video -%}
            <button type="button" class="blko-video__play" aria-label="{{ 'blko.video.play' | t: title: label | escape }}">
              <span class="blko-video__play-icon">{%- render 'blko-icon', name: 'play' -%}</span>
              {%- if section.settings.play_label != blank -%}
                <span class="blko-video__play-label">{{ section.settings.play_label | escape }}</span>
              {%- endif -%}
            </button>
            <template>
              {%- if video != blank -%}
                {{ video | video_tag: autoplay: true, controls: true, playsinline: true, image_size: '1600x', class: 'blko-video__player' }}
              {%- elsif video_url.type == 'youtube' -%}
                <iframe class="blko-video__player" src="https://www.youtube-nocookie.com/embed/{{ video_url.id }}?autoplay=1&rel=0&playsinline=1" title="{{ label | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
              {%- elsif video_url.type == 'vimeo' -%}
                <iframe class="blko-video__player" src="https://player.vimeo.com/video/{{ video_url.id }}?autoplay=1&dnt=1" title="{{ label | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
              {%- endif -%}
            </template>
          {%- endif -%}
        </blko-video>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .blko-video__head { display: grid; gap: .75rem; max-width: 46rem; margin-bottom: 2rem; }
  .blko-video__head--center { margin-inline: auto; justify-items: center; text-align: center; }
  .blko-video__frame { aspect-ratio: var(--blko-video-ratio, 16 / 9); }
  .blko-video--full .blko-video__frame { border-radius: 0; }
  .blko-video__poster { position: absolute; inset: 0; display: block; }
  .blko-video__frame .blko-video__cover, .blko-video__frame .blko-video__player { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .blko-video__play {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: inline-flex; align-items: center; gap: .75rem; min-height: 56px; padding: .375rem; border: 0;
    border-radius: var(--radius-button, 999px); background: var(--color-bg, #f6f2ea); color: var(--color-text, #262f29);
    font-size: var(--blko-text-button, 15px); font-weight: var(--button-weight, 500); text-transform: var(--button-case, none);
    letter-spacing: var(--button-tracking, 0); cursor: pointer; transition: transform .2s;
  }
  .blko-video__play:hover { transform: translate(-50%, -50%) scale(1.04); }
  .blko-video__play-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; background: var(--color-button, #262f29); color: var(--color-button-text, #f6f2ea); }
  .blko-video__play-icon svg { width: 1rem; height: 1rem; }
  .blko-video__play-label { padding-right: 1rem; }
  @media (min-width: 1024px) { .blko-video__head { margin-bottom: 2.5rem; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "blko-video-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Three drops, <em>one minute</em>" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "blko-h2",
      "options": [
        { "value": "blko-h3", "label": "Small" },
        { "value": "blko-h2", "label": "Medium" },
        { "value": "blko-h1", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Video" },
    { "type": "video", "id": "video", "label": "Video", "info": "Upload a video to Shopify. Takes priority over the link below." },
    { "type": "video_url", "id": "video_url", "label": "YouTube or Vimeo link", "accept": ["youtube", "vimeo"] },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay muted and loop", "default": false, "info": "Uploaded videos only. Plays without sound or controls, like a moving photo." },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image", "info": "Shown before the video plays." },
    {
      "type": "select", "id": "fallback_image", "label": "Placeholder", "default": "lifestyle-1", "info": "Shown until you pick an image.",
      "options": [
        { "value": "lifestyle-1", "label": "Lifestyle 1" },
        { "value": "lifestyle-2", "label": "Lifestyle 2" },
        { "value": "image", "label": "Image" },
        { "value": "product-1", "label": "Product 1" },
        { "value": "product-2", "label": "Product 2" },
        { "value": "product-3", "label": "Product 3" },
        { "value": "product-4", "label": "Product 4" },
        { "value": "product-5", "label": "Product 5" },
        { "value": "product-6", "label": "Product 6" },
        { "value": "collection-1", "label": "Collection 1" },
        { "value": "collection-2", "label": "Collection 2" },
        { "value": "collection-3", "label": "Collection 3" },
        { "value": "collection-4", "label": "Collection 4" },
        { "value": "collection-5", "label": "Collection 5" },
        { "value": "collection-6", "label": "Collection 6" }
      ]
    },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Watch the routine", "info": "Leave blank for an icon-only button." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "ratio", "label": "Ratio", "default": "16 / 9",
      "options": [
        { "value": "16 / 9", "label": "Widescreen 16:9" },
        { "value": "21 / 9", "label": "Cinema 21:9" },
        { "value": "4 / 3", "label": "Classic 4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait 4:5" }
      ]
    },
    { "type": "checkbox", "id": "full_width", "label": "Full page width", "default": false }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
