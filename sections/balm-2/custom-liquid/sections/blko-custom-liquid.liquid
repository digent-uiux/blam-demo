{%- comment -%} Custom Liquid: merchant-written Liquid/HTML inside the theme's spacing and color scheme. {%- endcomment -%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-cliquid"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px;"
>
  {%- if section.settings.container -%}
    <div class="blko-container">{{ section.settings.custom_liquid }}</div>
  {%- else -%}
    {{ section.settings.custom_liquid }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "blko-cliquid-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "header", "content": "Content" },
    { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "info": "Add app snippets or other Liquid code." },
    { "type": "checkbox", "id": "container", "label": "Keep within page width", "default": true }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
