{%- comment -%} Rich text: a quiet column of heading, text and buttons. Every part is a block, so order is free. {%- endcomment -%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-rtext blko-rtext--{{ section.settings.alignment }}"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="blko-container">
    <div class="blko-rtext__inner blko-rtext__inner--{{ section.settings.content_width }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}
            <p class="blko-label blko-muted blko-rtext__caption" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }} blko-rtext__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="{{ block.settings.size }} blko-rte blko-pretty{% if block.settings.muted %} blko-muted{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank or block.settings.label_2 != blank -%}
              <div class="blko-rtext__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <a class="blko-btn blko-btn--{{ block.settings.style }}"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ block.settings.label | escape }}</a>
                {%- endif -%}
                {%- if block.settings.label_2 != blank -%}
                  <a class="blko-btn blko-btn--{{ block.settings.style_2 }}"{% if block.settings.link_2 != blank %} href="{{ block.settings.link_2 }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ block.settings.label_2 | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .blko-rtext__inner { display: grid; gap: 1.25rem; }
  .blko-rtext__inner--narrow { max-width: 36rem; }
  .blko-rtext__inner--medium { max-width: 48rem; }
  .blko-rtext__inner--wide { max-width: 64rem; }
  .blko-rtext--center .blko-rtext__inner { margin-inline: auto; justify-items: center; text-align: center; }
  .blko-rtext--right .blko-rtext__inner { margin-left: auto; justify-items: end; text-align: right; }
  .blko-rtext__caption { text-transform: uppercase; }
  .blko-rtext__heading + * { margin-top: .25rem; }
  .blko-rtext__buttons { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .5rem; }
  .blko-rtext--center .blko-rtext__buttons { justify-content: center; }
  .blko-rtext--right .blko-rtext__buttons { justify-content: flex-end; }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "blko-rtext-section",
  "max_blocks": 10,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "alignment", "label": "Alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "content_width", "label": "Content width", "default": "medium",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "wide", "label": "Wide" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Our promise" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Fewer steps, <em>better</em> skin" },
        {
          "type": "select", "id": "size", "label": "Size", "default": "blko-h2",
          "options": [
            { "value": "blko-h3", "label": "Small" },
            { "value": "blko-h2", "label": "Medium" },
            { "value": "blko-h1", "label": "Large" },
            { "value": "blko-display", "label": "Extra large" }
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make a short list of formulas that each do one job well, so a routine takes minutes, not a shelf.</p>" },
        {
          "type": "select", "id": "size", "label": "Size", "default": "blko-body-lg",
          "options": [
            { "value": "blko-small", "label": "Small" },
            { "value": "blko-body", "label": "Medium" },
            { "value": "blko-body-lg", "label": "Large" }
          ]
        },
        { "type": "checkbox", "id": "muted", "label": "Muted colour", "default": true }
      ]
    },
    {
      "type": "button",
      "name": "Buttons",
      "settings": [
        { "type": "text", "id": "label", "label": "First button label", "default": "Shop the range", "info": "Leave blank to hide." },
        { "type": "url", "id": "link", "label": "First button link" },
        {
          "type": "select", "id": "style", "label": "First button style", "default": "primary",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ]
        },
        { "type": "text", "id": "label_2", "label": "Second button label", "info": "Leave blank to hide." },
        { "type": "url", "id": "link_2", "label": "Second button link" },
        {
          "type": "select", "id": "style_2", "label": "Second button style", "default": "outline",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
