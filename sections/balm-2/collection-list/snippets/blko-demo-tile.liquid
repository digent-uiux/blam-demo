{%- comment -%}
  GENERATED by liquid/_tools/sync-theme.py from liquid/_demo/<id>.json, do not edit.
  Demo collection for collection lists/tiles with no collection picked.
  Accepts: index {Number} 1-based, wraps; part {String} 'image' (photo only), 'title' (text only), blank = full tile;
  sizes {String}; media_class {String} extra class on the media box
{%- endcomment -%}
{%- liquid
  assign n = index | default: 1 | minus: 1 | modulo: 4 | plus: 1
  case n
    when 1
      assign image = 'collection-1'
    when 2
      assign image = 'collection-2'
    when 3
      assign image = 'collection-3'
    when 4
      assign image = 'collection-4'
  endcase
  assign key = 'blko.demo.collection_' | append: n
-%}
{%- case part -%}
  {%- when 'image' -%}{%- render 'blko-fallback-image', name: image, sizes: sizes -%}
  {%- when 'title' -%}{{ key | t }}
  {%- else -%}
<a class="blko-tile" href="{{ routes.collections_url }}">
  <div class="blko-media {{ media_class }} blko-tile__media">{%- render 'blko-fallback-image', name: image, sizes: sizes -%}</div>
  <span class="blko-tile__title">{{ key | t }}</span>
</a>
{%- endcase -%}
