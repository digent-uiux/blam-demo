{%- comment -%} Multicolumn: heading + intro, then columns of image or icon, title, text and a link. {%- endcomment -%}
{%- liquid
  assign cols_d = section.settings.columns_desktop
  assign cols_m = section.settings.columns_mobile | plus: 0
  if cols_d > 3
    assign cols_t = 2
  else
    assign cols_t = cols_d
  endif
  assign media_vw = 100 | divided_by: cols_d
  assign sizes = '(min-width: 1024px) ' | append: media_vw | append: 'vw, 100vw'
  case section.settings.image_ratio
    when 'portrait'
      assign media_class = 'blko-media--portrait'
    when 'landscape'
      assign media_class = 'blko-media--landscape'
    when 'adapt'
      assign media_class = 'blko-mcol__media--adapt'
    else
      assign media_class = 'blko-media--square'
  endcase
-%}
<div
  class="blko-section blko-scheme color-{{ section.settings.color_scheme }} blko-mcol blko-mcol--{{ section.settings.text_alignment }}{% if section.settings.column_style == 'card' %} blko-mcol--card{% endif %}"
  style="--blko-pt: {{ section.settings.padding_top }}px; --blko-pb: {{ section.settings.padding_bottom }}px; --blko-cols-d: {{ cols_d }}; --blko-cols-t: {{ cols_t }}; --blko-cols-m: {{ cols_m }};"
>
  <div class="blko-container">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="blko-mcol__head{% if section.settings.heading_alignment == 'center' %} blko-mcol__head--center{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="blko-body-lg blko-muted blko-pretty blko-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    <ul class="blko-mcol__grid blko-list-reset" role="list">
      {%- for block in section.blocks -%}
        <li class="blko-mcol__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="blko-media {{ media_class }} blko-mcol__media">
              {%- assign alt = block.settings.image.alt | default: block.settings.title | escape -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: sizes, widths: '360, 540, 720, 1000', alt: alt }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="blko-mcol__icon" aria-hidden="true">{%- render 'blko-icon', name: block.settings.icon -%}</span>
          {%- endif -%}
          <div class="blko-mcol__body">
            {%- if block.settings.title != blank -%}
              <h3 class="blko-mcol__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="blko-small blko-muted blko-pretty blko-rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="blko-text-link blko-mcol__link"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% else %} role="link" aria-disabled="true"{% endif %}>
                {{- block.settings.link_label | escape }}
                {% render 'blko-icon', name: 'arrow-right' -%}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="blko-mcol__footer">
        <a class="blko-btn blko-btn--{{ section.settings.button_style }}"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .blko-mcol__head { display: grid; gap: .75rem; max-width: 46rem; margin-bottom: 2.5rem; }
  .blko-mcol__head--center { margin-inline: auto; justify-items: center; text-align: center; }
  .blko-mcol__grid { display: grid; grid-template-columns: repeat(var(--blko-cols-m, 1), minmax(0, 1fr)); gap: 2.5rem 1.5rem; margin: 0; }
  .blko-mcol__item { display: grid; align-content: start; gap: 1.25rem; }
  .blko-mcol--center .blko-mcol__item { justify-items: center; text-align: center; }
  .blko-mcol__media { width: 100%; }
  .blko-mcol__media--adapt > img { height: auto; }
  .blko-mcol__icon { display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid var(--color-border, #d6d1c0); border-radius: 999px; color: var(--color-accent, #666237); }
  .blko-mcol__icon svg { width: 1.25rem; height: 1.25rem; }
  .blko-mcol__body { display: grid; gap: .5rem; }
  .blko-mcol__title { font-family: var(--font-heading, "Bodoni Moda", Georgia, serif); font-weight: var(--font-heading-weight, 500); font-size: var(--blko-text-h4); line-height: 1.25; text-wrap: balance; }
  .blko-mcol__link { margin-top: .25rem; }
  .blko-mcol--card .blko-mcol__item { padding: 1.75rem 1.5rem; background: var(--color-bg-alt, #e4e0cc); border-radius: var(--radius-card, 0); }
  .blko-mcol__footer { display: flex; justify-content: center; margin-top: 3rem; }
  @media (min-width: 750px) { .blko-mcol__grid { grid-template-columns: repeat(var(--blko-cols-t, 2), minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .blko-mcol__head { margin-bottom: 3.5rem; }
    .blko-mcol__grid { grid-template-columns: repeat(var(--blko-cols-d, 3), minmax(0, 1fr)); column-gap: 2rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "blko-mcol-section",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "What goes into <em>every</em> bottle" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "blko-h2",
      "options": [
        { "value": "blko-h3", "label": "Small" },
        { "value": "blko-h2", "label": "Medium" },
        { "value": "blko-h1", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "heading_alignment", "label": "Heading alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "header", "content": "Columns" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 1, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select", "id": "column_style", "label": "Column style", "default": "plain",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "card", "label": "Panel" }
      ]
    },
    {
      "type": "select", "id": "text_alignment", "label": "Column alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "adapt", "label": "Adapt to image" }
      ]
    },
    { "type": "header", "content": "Button below columns" },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave blank to hide." },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "button_style", "label": "Button style", "default": "outline",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown instead of the icon." },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "check", "label": "Check" },
            { "value": "ruler", "label": "Ruler" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Plant-first formulas" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Botanical oils and extracts do the work. Nothing added for scent or colour.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "Leave blank to hide." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "icon": "leaf", "title": "Plant-first formulas", "text": "<p>Botanical oils and extracts do the work. Nothing added for scent or colour.</p>" } },
        { "type": "column", "settings": { "icon": "droplet", "title": "Small, fresh batches", "text": "<p>Pressed and bottled within the week, with the batch date on every label.</p>" } },
        { "type": "column", "settings": { "icon": "shield", "title": "Gentle by default", "text": "<p>Patch-tested on sensitive skin and free from alcohol and essential oils.</p>" } }
      ]
    }
  ]
}
{% endschema %}
