{%- comment -%} Announcement bar: one line with an italic accent word, optional code chip and link, optionally dismissible. {%- endcomment -%}
{%- liquid
  assign show_bar = true
  if section.settings.home_only and request.page_type != 'index'
    assign show_bar = false
  endif
-%}
{%- if section.settings.text != blank and show_bar -%}
  {%- if section.settings.dismissible -%}
    <script src="{{ 'blko-announcement.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <blko-announcement
    class="blko-announcement blko-scheme color-{{ section.settings.color_scheme }} blko-announcement--{{ section.settings.text_style }}"
    style="--blko-ann-pt: {{ section.settings.padding_top }}px; --blko-ann-pb: {{ section.settings.padding_bottom }}px;"
    data-key="blko-announcement-{{ section.id }}"
    role="region"
    aria-label="{{ 'blko.announcement.label' | t }}"
  >
    <div class="blko-announcement__inner{% if section.settings.dismissible %} blko-announcement__inner--dismiss{% endif %}">
      <p class="blko-announcement__text">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="blko-announcement__link">{{ section.settings.text }}</a>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </p>
      {%- if section.settings.code != blank -%}
        <span class="blko-announcement__code">{{ section.settings.code | escape }}</span>
      {%- endif -%}
      {%- if section.settings.dismissible -%}
        <button type="button" class="blko-announcement__close" data-dismiss aria-label="{{ 'blko.announcement.dismiss' | t }}">
          {%- render 'blko-icon', name: 'close' -%}
        </button>
      {%- endif -%}
    </div>
  </blko-announcement>
{%- endif -%}

{% stylesheet %}
  .blko-announcement { display: block; }
  .blko-announcement[hidden] { display: none; }
  .blko-announcement__inner { position: relative; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .25rem .75rem; min-height: 48px; padding: var(--blko-ann-pt, 8px) 1rem var(--blko-ann-pb, 8px); text-align: center; }
  .blko-announcement__inner--dismiss { padding-right: 3rem; }
  @media (min-width: 750px) { .blko-announcement__inner--dismiss { padding-inline: 3rem; } }
  .blko-announcement__text { font-family: var(--font-heading, Georgia, serif); font-size: var(--blko-text-h4, 20px); line-height: 1.2; }
  .blko-announcement--body .blko-announcement__text { font-family: var(--font-body, system-ui, sans-serif); font-size: var(--blko-text-small, 14px); }
  .blko-announcement__text em { font-style: var(--heading-italic, italic); }
  .blko-announcement__link { text-decoration: none; }
  .blko-announcement__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .blko-announcement__code { display: inline-flex; align-items: center; height: 24px; padding: 0 .625rem; border: 1px solid color-mix(in srgb, currentColor 40%, transparent); border-radius: 999px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: var(--blko-text-label, 12px); letter-spacing: .1em; }
  .blko-announcement__close { position: absolute; right: .75rem; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 999px; background: transparent; color: inherit; opacity: .8; cursor: pointer; }
  .blko-announcement__close:hover { opacity: 1; background: color-mix(in srgb, currentColor 15%, transparent); }
  .blko-announcement__close svg { width: 16px; height: 16px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "blko-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "It’s <em>glow</em> season, 15% off your first order", "info": "Use italic for the accent word." },
    { "type": "text", "id": "code", "label": "Code chip", "default": "GLOW15", "info": "Leave empty to hide." },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        { "value": "heading", "label": "Heading font" },
        { "value": "body", "label": "Body font, small" }
      ],
      "default": "heading"
    },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "dismissible", "label": "Show dismiss button", "default": true },
    { "type": "checkbox", "id": "home_only", "label": "Show on the home page only", "default": true }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
