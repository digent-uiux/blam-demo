{%- assign s = section.settings -%}
{{ 'blko-customer.css' | asset_url | stylesheet_tag }}
<div class="blko-section blko-scheme color-{{ s.color_scheme }} blko-account" style="--blko-pt: {{ s.padding_top }}px; --blko-pb: {{ s.padding_bottom }}px; --blko-form-w: {{ s.form_width }}px;">
  <div class="blko-container">
    {%- capture body -%}
      <div class="blko-account__narrow">
        {%- if s.heading != blank -%}<h1 class="blko-{{ s.heading_size }}">{{ s.heading | escape }}</h1>{%- endif -%}
        {%- if s.text != blank -%}<div class="blko-rte blko-account__intro">{{ s.text }}</div>{%- endif -%}
        {%- form 'create_customer', novalidate: 'novalidate', class: 'blko-account__form' -%}
          {%- if form.errors -%}
            <div class="blko-account__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          {%- if s.show_names -%}
            <div class="blko-account__fields blko-account__fields--2">
              <div class="blko-account__field">
                <label for="BlkoRegFirst">{{ 'blko.customer.first_name' | t }}</label>
                <input id="BlkoRegFirst" class="blko-input" type="text" name="customer[first_name]" autocomplete="given-name" value="{{ form.first_name }}">
              </div>
              <div class="blko-account__field">
                <label for="BlkoRegLast">{{ 'blko.customer.last_name' | t }}</label>
                <input id="BlkoRegLast" class="blko-input" type="text" name="customer[last_name]" autocomplete="family-name" value="{{ form.last_name }}">
              </div>
            </div>
          {%- endif -%}
          <div class="blko-account__field">
            <label for="BlkoRegEmail">{{ 'blko.customer.email' | t }}</label>
            <input id="BlkoRegEmail" class="blko-input" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" value="{{ form.email }}" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
          </div>
          <div class="blko-account__field">
            <label for="BlkoRegPassword">{{ 'blko.customer.password' | t }}</label>
            <input id="BlkoRegPassword" class="blko-input" type="password" name="customer[password]" autocomplete="new-password" required{% if form.errors contains 'password' %} aria-invalid="true"{% endif %}>
          </div>
          {%- if s.show_marketing -%}
            <label class="blko-account__check">
              <input type="checkbox" name="customer[accepts_marketing]" value="true">
              {{ 'blko.customer.accepts_marketing' | t }}
            </label>
          {%- endif -%}
          <button type="submit" class="blko-btn blko-btn--primary blko-btn--full">{{ 'blko.customer.create' | t }}</button>
        {%- endform -%}
        {%- if s.show_login_link -%}
          <div class="blko-account__links"><a href="{{ routes.account_login_url }}">{{ 'blko.customer.have_account' | t }}</a></div>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- render 'blko-account-shell', section: section, body: body, fallback: 'account' -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer register",
  "tag": "section",
  "class": "blko-main-register",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create an account"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h3",
          "label": "Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Side by side with image"
        }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "form_width",
      "label": "Form width",
      "min": 360,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 440
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_names",
      "label": "Show name fields",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_marketing",
      "label": "Show email sign-up checkbox",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login_link",
      "label": "Show log in link",
      "default": true
    }
  ]
}
{% endschema %}
