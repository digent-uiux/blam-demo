{%- comment -%}
  Lucide icons for Bundle 01 (ISC licence, lucide.dev), 24px grid, currentColor.
  Accepts:
  - name: {String} 'tag' or 'check'
  - stroke: {Number} stroke width, default 2
  - class: {String} optional extra class
{%- endcomment -%}
<svg class="blko-b01__icon{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke | default: 2 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'tag' -%}<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
  {%- endcase -%}
</svg>
