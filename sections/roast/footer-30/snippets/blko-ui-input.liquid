{%- comment -%}Input: native attributes + className. describedBy points to Field hint/error. invalid sets aria-invalid.{%- endcomment -%}
<input class="blko-ui-input {{ className }}" type="{{ type | default: 'text' | escape }}"{% if id != blank %} id="{{ id | escape }}"{% endif %}{% if name != blank %} name="{{ name | escape }}"{% endif %}{% if value != nil %} value="{{ value | escape }}"{% endif %}{% if placeholder != blank %} placeholder="{{ placeholder | escape }}"{% endif %}{% if label != blank %} aria-label="{{ label | escape }}"{% endif %}{% if describedBy != blank %} aria-describedby="{{ describedBy | escape }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if autocomplete != blank %} autocomplete="{{ autocomplete | escape }}"{% endif %}{% if min != nil %} min="{{ min }}"{% endif %}{% if max != nil %} max="{{ max }}"{% endif %}{% if step != nil %} step="{{ step }}"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if readonly %} readonly{% endif %}>
