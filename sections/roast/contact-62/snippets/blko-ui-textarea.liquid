{%- comment -%}Textarea: same Field wiring as Input. rows defaults to 4.{%- endcomment -%}
<textarea class="blko-ui-input blko-ui-textarea {{ className }}" rows="{{ rows | default: 4 }}"{% if id != blank %} id="{{ id | escape }}"{% endif %}{% if name != blank %} name="{{ name | escape }}"{% endif %}{% if placeholder != blank %} placeholder="{{ placeholder | escape }}"{% endif %}{% if label != blank %} aria-label="{{ label | escape }}"{% endif %}{% if describedBy != blank %} aria-describedby="{{ describedBy | escape }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if required %} required{% endif %}{% if disabled %} disabled{% endif %}{% if readonly %} readonly{% endif %}>{{ value | escape }}</textarea>
