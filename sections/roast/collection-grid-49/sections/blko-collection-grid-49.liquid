{%- liquid
  assign s = section.settings
-%}
{{ 'blko-ui-core.css' | asset_url | stylesheet_tag }}
{{ 'blko-collection-grid-49.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-motion.js' | asset_url }}" defer="defer"></script>
{{ 'blko-ui-commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-ui-commerce.js' | asset_url }}" defer="defer"></script>
{{ 'blko-roast-motion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'blko-roast-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'blko-collection-grid-49.js' | asset_url }}" defer="defer"></script>
{%- render 'blko-fonts-roast', tokens: s.tokens -%}
{%- liquid
  assign live = false
  if collection != blank and collection.handle != blank
    assign live = true
  endif
  assign per = s.per_page
  assign roasts = s.roast_names | newline_to_br | split: '<br />'
  assign tile = nil
  for b in section.blocks
    if b.type == 'tile'
      assign tile = b
      break
    endif
  endfor
  assign tile_after = 3
  if tile != nil
    assign tile_after = tile.settings.after
  endif
  assign n = 0
  assign cur_page = 1
  assign pages = 1
  assign next_url = ''
  assign prev_url = ''
-%}
{%- capture cards -%}
  {%- if live -%}
    {%- paginate collection.products by per -%}
      {%- for p in collection.products -%}
        {%- assign d = forloop.index0 | times: 70 | plus: 80 -%}
        <li class="rm-rise bcollectiongrid49__cell" style="--d:{{ d }}ms" data-card
          >{%- render 'blko-ui-product-card', product: p, vendor: p.vendor, ratio: 'portrait', quickAdd: s.quick_add, wishlist: s.wishlist -%}
        </li
        >{%- if forloop.index == tile_after and paginate.current_page == 1 and tile != nil -%}
          {%- assign td = tile_after | times: 70 | plus: 80 -%}
          {%- render 'blko-collection-grid-49-tile', t: tile, d: td -%}
        {%- endif -%}
      {%- endfor -%}
      {%- liquid
        assign n = collection.products.size
        assign total = paginate.items
        assign start = paginate.current_offset
        assign end_n = start | plus: n
        assign cur_page = paginate.current_page
        assign pages = paginate.pages
        if paginate.next
          assign next_url = paginate.next.url
        endif
        if paginate.previous
          assign prev_url = paginate.previous.url
        endif
      -%}
      {%- capture page_links -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <li class="bcollectiongrid49__pgli"><a href="{{ part.url }}" aria-label="{{ 'blko.collection_grid_49.page' | t | replace: '[n]', part.title }}" class="bcollectiongrid49__pg" data-pg="{{ part.title }}">{{ part.title }}</a></li
          >{%- elsif part.title == paginate.current_page -%}
            <li class="bcollectiongrid49__pgli"><a href="{{ request.path }}" aria-current="page" aria-label="{{ 'blko.collection_grid_49.page' | t | replace: '[n]', part.title }}" class="bcollectiongrid49__pg" data-pg="{{ part.title }}">{{ part.title }}</a></li
          >{%- else -%}
            <li class="bcollectiongrid49__pgli"><span class="bcollectiongrid49__pg bcollectiongrid49__gap">{{ part.title }}</span></li
          >{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- for b in section.blocks -%}
      {%- if b.type != 'product' -%}{%- continue -%}{%- endif -%}
      {%- assign bs = b.settings -%}
      {%- assign ri = bs.roast | minus: 1 -%}
      {%- assign rname = roasts[ri] | strip -%}
      {%- capture vendor -%}{{ bs.origin }} · {{ bs.process }} · {{ rname }}{%- endcapture -%}
      {%- assign d = n | times: 70 | plus: 80 -%}
      <li class="rm-rise bcollectiongrid49__cell" style="--d:{{ d }}ms" data-card data-i="{{ n }}" data-origin="{{ bs.origin | escape }}" data-process="{{ bs.process | escape }}" data-roast="{{ bs.roast }}" data-price="{{ bs.price }}" data-rating="{{ bs.value }}" data-count="{{ bs.count }}" data-fresh="{{ bs.fresh }}"{% if n >= per %} hidden{% endif %} {{ b.shopify_attributes }}>
        {%- if bs.label != blank -%}
          {%- render 'blko-ui-product-card', product: bs.product, title: bs.title, vendor: vendor, image: bs.image, price: bs.price, rating: bs, badge: bs, ratio: 'portrait', quickAdd: s.quick_add, wishlist: s.wishlist -%}
        {%- else -%}
          {%- render 'blko-ui-product-card', product: bs.product, title: bs.title, vendor: vendor, image: bs.image, price: bs.price, rating: bs, ratio: 'portrait', quickAdd: s.quick_add, wishlist: s.wishlist -%}
        {%- endif -%}
      </li
      >{%- assign n = n | plus: 1 -%}
      {%- if n == tile_after and tile != nil -%}
        {%- assign td = tile_after | times: 70 | plus: 80 -%}
        {%- render 'blko-collection-grid-49-tile', t: tile, d: td -%}
      {%- endif -%}
    {%- endfor -%}
    {%- liquid
      assign total = n
      assign start = 0
      assign end_n = n | at_most: per
      assign pages = total | plus: per | minus: 1 | divided_by: per | floor | at_least: 1
    -%}
    {%- capture page_links -%}
      {%- for i in (1..pages) -%}
        <li class="bcollectiongrid49__pgli"><button type="button" aria-label="{{ 'blko.collection_grid_49.page' | t | replace: '[n]', i }}"{% if i == 1 %} aria-current="page"{% endif %} class="bcollectiongrid49__pg" data-pg="{{ i }}">{{ i }}</button></li
      >{%- endfor -%}
    {%- endcapture -%}
  {%- endif -%}
{%- endcapture -%}
{%- liquid
  assign is_empty = false
  if n == 0
    assign is_empty = true
  endif
  assign frac = 0
  if total > 0
    assign frac = end_n | times: 1.0 | divided_by: total
  endif
  assign more = false
  if live and next_url != blank
    assign more = true
  endif
  if live == false and pages > 1
    assign more = true
  endif
-%}
{%- capture body -%}
  <h2 class="bcollectiongrid49__sr">{{ 'blko.collection_grid_49.products' | t }}</h2
  ><div class="bcollectiongrid49__empty" data-empty{% unless is_empty %} hidden{% endunless %}
    ><p class="bcollectiongrid49__label bcollectiongrid49__muted">{{ 'blko.collection_grid_49.zero' | t }}</p
    ><p class="bcollectiongrid49__etitle rm-heading">{{ 'blko.collection_grid_49.empty_title' | t }}</p
    ><p class="bcollectiongrid49__etext">{{ 'blko.collection_grid_49.empty_text' | t }}</p
    >{%- capture clear_label -%}<span class="rm-roll"><span>{{ 'blko.collection_grid_49.clear' | t }}</span></span>{%- endcapture -%}
    {%- capture clear_attrs -%}data-reset{% if live %} data-href="{{ collection.url }}"{% endif %}{%- endcapture -%}
    {%- render 'blko-ui-button', variant: 'outline', attrs: clear_attrs, children: clear_label -%}
  </div
  ><ul class="bcollectiongrid49__grid bcollectiongrid49__grid--{{ s.columns }}" data-grid{% if is_empty %} hidden{% endif %}>{{ cards }}</ul
  ><nav aria-label="{{ 'blko.collection_grid_49.pagination' | t }}" class="bcollectiongrid49__nav" data-nav{% if is_empty %} hidden{% endif %}
    ><div class="bcollectiongrid49__prog"
      >{%- liquid
        if cur_page == 1
          assign first_n = end_n
        else
          assign s1 = start | plus: 1
          assign first_n = s1 | append: '–' | append: end_n
        endif
      -%}
      <p aria-live="polite" class="bcollectiongrid49__label bcollectiongrid49__muted">{{ 'blko.collection_grid_49.showing' | t }} <span class="bcollectiongrid49__strong" data-end>{{ first_n }}</span> {{ 'blko.collection_grid_49.of' | t }} <span class="bcollectiongrid49__strong" data-total>{{ total }}</span></p
      ><span aria-hidden="true" class="bcollectiongrid49__track"><span class="bcollectiongrid49__fill" data-fill style="transform: scaleX({{ frac }})"></span></span
    ></div
    >{%- capture more_label -%}<span class="rm-roll"><span>{{ 'blko.collection_grid_49.load_more' | t }}</span></span>{%- endcapture -%}
    <div class="bcollectiongrid49__mid"
      ><span data-more-wrap{% unless more %} hidden{% endunless %}>{%- render 'blko-ui-button', size: 'lg', iconAfter: 'arrow-down', attrs: 'data-more', children: more_label -%}</span
      ><p class="bcollectiongrid49__label bcollectiongrid49__muted" data-all{% if more %} hidden{% endif %}>{{ 'blko.collection_grid_49.all' | t }}</p
    ></div
    ><ol class="bcollectiongrid49__pages"
      ><li>{%- if live and prev_url != blank -%}<a href="{{ prev_url }}" aria-label="{{ 'blko.collection_grid_49.prev' | t }}" class="bcollectiongrid49__arrow">{% render 'blko-ui-icon', name: 'arrow-left', size: 16, className: 'rm-nudge' %}</a>{%- else -%}<button type="button" aria-label="{{ 'blko.collection_grid_49.prev' | t }}" class="bcollectiongrid49__arrow" data-prev disabled>{% render 'blko-ui-icon', name: 'arrow-left', size: 16, className: 'rm-nudge' %}</button>{%- endif -%}</li
      >{{ page_links -}}
      <li data-nextli>{%- if live and next_url != blank -%}<a href="{{ next_url }}" aria-label="{{ 'blko.collection_grid_49.next' | t }}" class="bcollectiongrid49__arrow" data-next-link>{% render 'blko-ui-icon', name: 'arrow-right', size: 16, className: 'rm-nudge' %}</a>{%- else -%}<button type="button" aria-label="{{ 'blko.collection_grid_49.next' | t }}" class="bcollectiongrid49__arrow" data-next{% if live or pages < 2 %} disabled{% endif %}>{% render 'blko-ui-icon', name: 'arrow-right', size: 16, className: 'rm-nudge' %}</button>{%- endif -%}</li
    ></ol
  ></nav
>{%- endcapture -%}
<div class="bcollectiongrid49" data-tokens="{{ s.tokens }}" style="--pt:{{ s.padding_top }}px;--pb:{{ s.padding_bottom }}px" data-roast data-rm-magnetic data-mode="{% if live %}live{% else %}demo{% endif %}" data-per="{{ per }}" data-page="{{ cur_page }}" data-pages="{{ pages }}" data-next="{{ next_url }}" data-start="{{ start }}" data-end="{{ end_n }}" data-total="{{ total }}" data-tile-after="{{ tile_after }}" data-l-page="{{ 'blko.collection_grid_49.page' | t }}"
  >{%- render 'blko-ui-section', surface: 'bg', label: s.label, inner: 'bcollectiongrid49__inner', children: body -%}
</div

>

{% schema %}
{
  "name": "Collection grid, flight",
  "tag": "div",
  "settings": [
    {
