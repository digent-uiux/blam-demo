{%- assign s = section.settings -%}
{{ 'blko-customer.css' | asset_url | stylesheet_tag }}
<div class="blko-section blko-scheme color-{{ s.color_scheme }} blko-account" style="--blko-pt: {{ s.padding_top }}px; --blko-pb: {{ s.padding_bottom }}px; --blko-form-w: {{ s.form_width }}px;">
  <div class="blko-container">
    {%- capture body -%}
      <div class="blko-account__narrow">
        {%- if s.heading != blank -%}<h1 class="blko-{{ s.heading_size }}">{{ s.heading | escape }}</h1>{%- endif -%}
        {%- if s.text != blank -%}<div class="blko-rte blko-account__intro">{{ s.text }}</div>{%- endif -%}
        {%- form 'reset_customer_password', class: 'blko-account__form' -%}
          {%- if form.errors -%}
            <div class="blko-account__errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="blko-account__field">
            <label for="BlkoResetPassword">{{ 'blko.customer.password' | t }}</label>
            <input id="BlkoResetPassword" class="blko-input" type="password" name="customer[password]" autocomplete="new-password" required>
          </div>
          <div class="blko-account__field">
            <label for="BlkoResetConfirm">{{ 'blko.customer.password_confirm' | t }}</label>
            <input id="BlkoResetConfirm" class="blko-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
          </div>
          <button type="submit" class="blko-btn blko-btn--primary blko-btn--full">{{ 'blko.customer.reset_submit' | t }}</button>
        {%- endform -%}
      </div>
    {%- endcapture -%}
    {%- render 'blko-account-shell', section: section, body: body, fallback: 'account' -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "class": "blko-main-reset-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose a new password"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h3",
          "label": "Small"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>Enter a new password for your account.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "split",
          "label": "Side by side with image"
        }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "form_width",
      "label": "Form width",
      "min": 360,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 440
    }
  ]
}
{% endschema %}
