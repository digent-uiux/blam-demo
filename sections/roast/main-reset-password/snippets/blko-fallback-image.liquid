{%- comment -%}
  GENERATED by liquid/_tools/sync-theme.py, do not edit. Shopify placeholder SVG shown until the merchant picks an
  image; the surrounding frame keeps the DS ratio.

  Accepts:
  - name: {String} a placeholder kind (lifestyle-1, lifestyle-2, image, product-1, product-2, product-3, product-4, product-5, product-6, collection-1, collection-2, collection-3, collection-4, collection-5, collection-6) or a role (hero, banner, feature,
    avatar, collection...); anything else shows a product placeholder
  - class: {String} optional extra class
  - sizes, eager: accepted for compatibility, unused
{%- endcomment -%}
{%- liquid
  assign kind = name | default: 'image'
  assign kinds = '|lifestyle-1|lifestyle-2|image|product-1|product-2|product-3|product-4|product-5|product-6|collection-1|collection-2|collection-3|collection-4|collection-5|collection-6|'
  assign probe = '|' | append: kind | append: '|'
  unless kinds contains probe
    case kind
      when 'hero', 'banner', 'video', 'newsletter', 'password', 'collection-banner'
        assign kind = 'lifestyle-1'
      when 'feature', 'account', 'studio', 'about', 'story'
        assign kind = 'lifestyle-2'
      when 'avatar', 'portrait', 'face', 'logo'
        assign kind = 'image'
      when 'collection'
        assign kind = 'collection-1'
      else
        assign kind = 'product-1'
    endcase
  endunless
  assign ph_class = 'blko-placeholder ' | append: class | strip
-%}
{{ kind | placeholder_svg_tag: ph_class }}
